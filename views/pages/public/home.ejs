<% layout("/layouts/boilerplate.ejs") %>

  <style>
    /* Custom CSS for Home Page */
    :root {
      --primary: #667eea;
      --secondary: #764ba2;
    }
    .gradient-text {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    .hero-section {
      background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
    }
    .btn-gradient {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      transition: all 0.3s ease;
    }
    .btn-gradient:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(102, 126, 234, 0.4) !important;
      color: white;
    }
    .badge-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #ffb347, #ffcc33);
    }
    .service-card {
      transition: all 0.3s ease;
    }
    .service-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1) !important;
    }
    .service-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
      transition: all 0.3s ease;
    }
    .service-card:hover .service-icon {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white !important;
      transform: scale(1.1);
    }
    .service-action i {
      transition: transform 0.3s ease;
    }
    .service-card:hover .service-action {
      color: var(--secondary) !important;
    }
    .service-card:hover .service-action i {
      transform: translateX(4px);
    }
    .step-card {
      transition: all 0.3s ease;
    }
    .step-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1) !important;
    }
    .step-number {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
    }
    .cta-container {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
    }
  </style>

  <!-- Hero Section -->
  <section class="hero-section position-relative overflow-hidden text-white pb-5">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background: url('https://images.unsplash.com/photo-1505843513577-22bb7d21e455?auto=format&fit=crop&q=80') center/cover no-repeat; z-index: 0;"></div>
    <div class="container position-relative z-1 py-5">
      <div class="row align-items-center min-vh-100 py-5">
        <div class="col-lg-6 pb-5 text-center text-lg-start" data-aos="fade-right">
          <h1 class="display-4 fw-bolder lh-sm mb-3">
            Professional Home Services
            <span class="gradient-text d-block">Delivered to Your Doorstep</span>
          </h1>
          <p class="fs-5 opacity-75 mb-4 lh-base mx-auto mx-lg-0" style="max-width: 600px;">
            Experience top-quality home services with just a few clicks. Our network of verified professionals is ready
            to solve all your home maintenance needs.
          </p>
          <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3 mt-4 mb-4">
            <a href="/services" class="btn btn-gradient btn-lg px-4 py-3 shadow-sm text-white border-0 fw-semibold">
              <i class="fas fa-tools me-2"></i>Book a Service
            </a>
            <a href="#how-it-works" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
              <i class="fas fa-play-circle me-2"></i>How It Works
            </a>
          </div>
          <div class="mt-4">
            <div class="d-flex align-items-center justify-content-center justify-content-lg-start flex-wrap gap-4">
              <div class="d-flex align-items-center gap-2 py-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white bg-opacity-25" style="width: 24px; height: 24px;"><i class="fas fa-shield-alt small"></i></div>
                <div class="fs-6 opacity-75">Verified Experts</div>
              </div>
              <div class="d-flex align-items-center gap-2 py-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white bg-opacity-25" style="width: 24px; height: 24px;"><i class="fas fa-check-circle small"></i></div>
                <div class="fs-6 opacity-75">Quality Guarantee</div>
              </div>
              <div class="d-flex align-items-center gap-2 py-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-white bg-opacity-25" style="width: 24px; height: 24px;"><i class="fas fa-clock small"></i></div>
                <div class="fs-6 opacity-75">On-Time Service</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6 d-none d-lg-block" data-aos="fade-left">
          <div class="position-relative rounded-4 overflow-hidden shadow-lg" style="height: 500px;">
            <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&q=80"
              alt="Professional home service" class="w-100 h-100 object-fit-cover">
            <div class="position-absolute bottom-0 end-0 mb-4 me-4 bg-white rounded-pill px-4 py-3 shadow-lg">
              <div class="d-flex align-items-center gap-3">
                <div class="badge-icon rounded-circle d-flex align-items-center justify-content-center text-white fs-5"><i class="fas fa-star"></i></div>
                <div>
                  <div class="fs-3 fw-bold text-dark lh-1">4.8</div>
                  <div class="small text-secondary">Customer Rating</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="position-absolute start-0 w-100" style="bottom: -1px; z-index: 2;">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
        <path fill="#ffffff" fill-opacity="1"
          d="M0,64L60,80C120,96,240,128,360,128C480,128,600,96,720,96C840,96,960,128,1080,133.3C1200,139,1320,117,1380,106.7L1440,96L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z">
        </path>
      </svg>
    </div>
  </section>

  <!-- Popular Categories Section -->
  <section class="categories-section py-5">
    <div class="container py-4">
      <div class="text-center mb-5" data-aos="fade-up">
        <span class="text-uppercase fw-bold text-primary mb-3 d-block" style="letter-spacing: 1.5px; font-size: 0.85rem;">WHAT WE OFFER</span>
        <h2 class="fs-1 fw-bold text-dark mb-3">Popular Service Categories</h2>
        <p class="fs-5 text-secondary mx-auto" style="max-width: 700px;">Browse our most popular service categories that cater to your everyday needs</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
          <a href="/services" class="text-decoration-none d-block h-100">
            <div class="service-card bg-white rounded-4 p-4 text-center h-100 shadow-sm border d-flex flex-column">
              <div class="service-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-2 text-primary">
                <i class="fas fa-tools"></i>
              </div>
              <h3 class="fs-5 fw-bold text-dark mb-2">Plumbing & Repairs</h3>
              <p class="text-secondary mb-4">Expert solutions for leaks, repairs, and installations</p>
              <div class="service-action mt-auto text-primary fw-semibold d-flex align-items-center justify-content-center gap-2">
                <span>View Services</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
          </a>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
          <a href="/services" class="text-decoration-none d-block h-100">
            <div class="service-card bg-white rounded-4 p-4 text-center h-100 shadow-sm border d-flex flex-column">
              <div class="service-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-2 text-primary">
                <i class="fas fa-bolt"></i>
              </div>
              <h3 class="fs-5 fw-bold text-dark mb-2">Electrical Work</h3>
              <p class="text-secondary mb-4">Safe & reliable electrical installations and repairs</p>
              <div class="service-action mt-auto text-primary fw-semibold d-flex align-items-center justify-content-center gap-2">
                <span>View Services</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
          </a>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
          <a href="/services" class="text-decoration-none d-block h-100">
            <div class="service-card bg-white rounded-4 p-4 text-center h-100 shadow-sm border d-flex flex-column">
              <div class="service-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-2 text-primary">
                <i class="fas fa-paint-roller"></i>
              </div>
              <h3 class="fs-5 fw-bold text-dark mb-2">Home Painting</h3>
              <p class="text-secondary mb-4">Transform your space with professional painting</p>
              <div class="service-action mt-auto text-primary fw-semibold d-flex align-items-center justify-content-center gap-2">
                <span>View Services</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
          </a>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
          <a href="/services" class="text-decoration-none d-block h-100">
            <div class="service-card bg-white rounded-4 p-4 text-center h-100 shadow-sm border d-flex flex-column">
              <div class="service-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-2 text-primary">
                <i class="fas fa-broom"></i>
              </div>
              <h3 class="fs-5 fw-bold text-dark mb-2">Cleaning Services</h3>
              <p class="text-secondary mb-4">Professional deep cleaning for a spotless home</p>
              <div class="service-action mt-auto text-primary fw-semibold d-flex align-items-center justify-content-center gap-2">
                <span>View Services</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
          </a>
        </div>
      </div>

      <div class="text-center mt-5" data-aos="fade-up">
        <a href="/services" class="btn btn-outline-primary btn-lg px-4 py-2 fw-semibold">
          <i class="fas fa-th-large me-2"></i>View All Categories
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-5 bg-light">
    <div class="container py-4">
      <div class="text-center mb-5" data-aos="fade-up">
        <span class="text-uppercase fw-bold text-primary mb-3 d-block" style="letter-spacing: 1.5px; font-size: 0.85rem;">EASY PROCESS</span>
        <h2 class="fs-1 fw-bold text-dark mb-3">How KnockNFix Works</h2>
        <p class="fs-5 text-secondary mx-auto" style="max-width: 700px;">Simple steps to get your home services delivered right at your doorstep</p>
      </div>

      <div class="row g-4 mt-3">
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
          <div class="step-card bg-white rounded-4 p-5 text-center position-relative shadow-sm border h-100">
            <div class="step-number position-absolute top-0 start-50 translate-middle rounded-circle text-white fw-bold d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px;">1</div>
            <div class="step-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-1 text-primary bg-light" style="width: 70px; height: 70px;">
              <i class="fas fa-mouse-pointer"></i>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-3">Select a Service</h3>
            <p class="text-secondary lh-base mb-0">Browse through our wide range of professional home services and select what you need</p>
          </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
          <div class="step-card bg-white rounded-4 p-5 text-center position-relative shadow-sm border h-100">
            <div class="step-number position-absolute top-0 start-50 translate-middle rounded-circle text-white fw-bold d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px;">2</div>
            <div class="step-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-1 text-primary bg-light" style="width: 70px; height: 70px;">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-3">Schedule an Appointment</h3>
            <p class="text-secondary lh-base mb-0">Choose your preferred date and time slot for the service to be performed</p>
          </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
          <div class="step-card bg-white rounded-4 p-5 text-center position-relative shadow-sm border h-100">
            <div class="step-number position-absolute top-0 start-50 translate-middle rounded-circle text-white fw-bold d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px;">3</div>
            <div class="step-icon rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center fs-1 text-primary bg-light" style="width: 70px; height: 70px;">
              <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="fs-5 fw-bold text-dark mb-3">Sit Back & Relax</h3>
            <p class="text-secondary lh-base mb-0">Our verified professional will arrive on time and provide quality service</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-5 bg-light border-bottom border-light-subtle">
    <div class="container py-4">
      <div class="cta-container rounded-4 p-5 p-md-5 text-center text-white shadow-lg position-relative overflow-hidden" data-aos="zoom-in">
        <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background: url('https://www.transparenttextures.com/patterns/cubes.png'); z-index: 0;"></div>
        <div class="position-relative z-1 py-3 py-md-4">
          <h2 class="display-6 fw-bold mb-3">Ready to Transform Your Home Services Experience?</h2>
          <p class="fs-5 opacity-75 mx-auto mb-5" style="max-width: 700px;">Join our platform and connect with verified professionals for all your home service needs</p>
          <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a href="/services" class="btn btn-light btn-lg px-4 py-3 fw-bold text-primary shadow-sm border-0">
              <i class="fas fa-tools me-2"></i>Book a Service Now
            </a>
            <a href="/signup" class="btn btn-outline-light btn-lg px-4 py-3 fw-bold">
              <i class="fas fa-user-plus me-2"></i>Create an Account
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  </script>

  <!-- Include AOS library for animations -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // Initialize AOS
    AOS.init({
      duration: 800,
      once: true
    });
  </script>