<% layout("/layouts/boilerplate.ejs") %>
<div class="container py-5">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="fas fa-tools me-2 text-primary"></i>My Services</h1>
    <a href="/dashboard/registerService" class="btn btn-primary btn-sm">
      <i class="fas fa-plus me-1"></i>Register New Service
    </a>
  </div>
  <% if (!services || services.length === 0) { %>
    <div class="card border-0 shadow-sm text-center py-5">
      <div class="card-body">
        <i class="fas fa-tools fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No services registered yet</h4>
        <p class="text-secondary mb-3">Register your first service to start receiving bookings.</p>
        <a href="/dashboard/registerService" class="btn btn-primary">Register a Service</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% services.forEach(function(s) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="card-title fw-bold mb-0"><%= s.name %></h6>
                <span class="badge bg-<%= s.isActive ? 'success' : 'secondary' %>">
                  <%= s.isActive ? 'Active' : 'Inactive' %>
                </span>
              </div>
              <p class="text-muted small mb-3"><%= s.description || 'No description' %></p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-primary">₹<%= s.price || 'N/A' %></span>
                <a href="/dashboard/service/<%= s._id %>" class="btn btn-outline-primary btn-sm">
                  <i class="fas fa-eye me-1"></i>Details
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
