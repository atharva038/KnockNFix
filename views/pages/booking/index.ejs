<% layout("/layouts/boilerplate.ejs") %>

  <!-- Enhanced Google Maps API key setup for booking page -->
  <% if (typeof googleMapsApiKey !=='undefined' && googleMapsApiKey) { %>
    <script>
      window.googleMapsApiKey = '<%= googleMapsApiKey %>';
      window.GOOGLE_MAPS_API_KEY = '<%= googleMapsApiKey %>';

      document.addEventListener('DOMContentLoaded', function () {
        try {
          if (!document.querySelector('meta[name="google-maps-api-key"]')) {
            const meta = document.createElement('meta');
            meta.name = 'google-maps-api-key';
            meta.content = '<%= googleMapsApiKey %>';
            document.head.appendChild(meta);
            console.log('✅ Google Maps API key added to booking page');
          }
        } catch (error) {
          console.error('❌ Failed to add Google Maps API key to booking page:', error);
        }
      });
    </script>
    <% } else { %>
      <script>
        console.warn('⚠️ Google Maps API key not found in booking.ejs');
      </script>
      <% } %>

        <link rel="stylesheet" href="/css/booking-fix.css">

        <div class="booking-page">
          <div class="container py-4">
            <div class="booking-progress mb-4">
              <div class="progress-step active">
                <div class="step-icon">1</div>
                <div class="step-text">Select Service</div>
              </div>
              <div class="progress-line"></div>
              <div class="progress-step active">
                <div class="step-icon">2</div>
                <div class="step-text">Book Service</div>
              </div>
              <div class="progress-line"></div>
              <div class="progress-step">
                <div class="step-icon">3</div>
                <div class="step-text">Confirm & Pay</div>
              </div>
            </div>

            <div class="card shadow-lg border-0 booking-card">
              <div class="card-header text-white py-4">
                <h2 class="text-center mb-0">
                  <i class="fas fa-calendar-check me-2"></i>Book Your Service
                </h2>
              </div>

              <div class="card-body p-4">
                <!-- Service Overview -->
                <div class="service-overview mb-4">
                  <div class="row align-items-center">
                    <div class="col-md-2 text-center mb-3 mb-md-0">
                      <img src="<%= service.img %>" alt="<%= service.name %>" class="service-img"
                        onerror="this.src='https://cdn-icons-png.flaticon.com/512/4202/4202841.png'" />
                    </div>
                    <div class="col-md-7 mb-3 mb-md-0">
                      <h3 class="service-name">
                        <%= service.name %>
                      </h3>
                      <p class="provider-name mb-2">
                        <i class="fas fa-user-circle me-2"></i>
                        <%= provider.user.name %>
                      </p>
                      <div class="service-details">
                        <span class="price">₹<%= serviceDetails.customCost %></span>
                        <span class="duration">
                          <i class="far fa-clock me-1"></i>
                          <%= service.duration %> mins
                        </span>
                        <% if (serviceDetails.experience) { %>
                          <span class="experience">
                            <i class="fas fa-briefcase me-1"></i>
                            <%= serviceDetails.experience %>
                          </span>
                          <% } %>
                      </div>
                    </div>
                    <div class="col-md-3 text-end">
                      <div class="service-rating">
                        <i class="fas fa-star"></i> 4.8
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Booking Form -->
                <form action="/booking/confirm" method="post" id="bookingForm">
                  <input type="hidden" name="serviceId" value="<%= service._id %>" />
                  <input type="hidden" name="providerId" value="<%= provider._id %>" />

                  <!-- Date & Time Section -->
                  <div class="form-section">
                    <div class="form-section-header">
                      <span class="section-number">1</span> Choose Date & Time
                    </div>
                    <div class="form-section-body">
                      <div class="mb-4">
                        <label class="form-label">
                          <i class="far fa-calendar-alt me-2"></i>Select Date and Time
                        </label>

                        <div class="date-time-container">
                          <div class="row g-2">
                            <div class="col-md-6">
                              <input type="date" id="date-picker" class="form-control"
                                min="<%= new Date().toISOString().split('T')[0] %>" required>
                            </div>
                            <div class="col-md-6">
                              <select id="time-picker" class="form-control" required>
                                <option value="" disabled selected>Select Time</option>
                                <option value="07:00">07:00 AM</option>
                                <option value="07:30">07:30 AM</option>
                                <option value="08:00">08:00 AM</option>
                                <option value="08:30">08:30 AM</option>
                                <option value="09:00">09:00 AM</option>
                                <option value="09:30">09:30 AM</option>
                                <option value="10:00">10:00 AM</option>
                                <option value="10:30">10:30 AM</option>
                                <option value="11:00">11:00 AM</option>
                                <option value="11:30">11:30 AM</option>
                                <option value="12:00">12:00 PM</option>
                                <option value="12:30">12:30 PM</option>
                                <option value="13:00">01:00 PM</option>
                                <option value="13:30">01:30 PM</option>
                                <option value="14:00">02:00 PM</option>
                                <option value="14:30">02:30 PM</option>
                                <option value="15:00">03:00 PM</option>
                                <option value="15:30">03:30 PM</option>
                                <option value="16:00">04:00 PM</option>
                                <option value="16:30">04:30 PM</option>
                                <option value="17:00">05:00 PM</option>
                                <option value="17:30">05:30 PM</option>
                                <option value="18:00">06:00 PM</option>
                                <option value="18:30">06:30 PM</option>
                                <option value="19:00">07:00 PM</option>
                                <option value="19:30">07:30 PM</option>
                                <option value="20:00">08:00 PM</option>
                                <option value="20:30">08:30 PM</option>
                                <option value="21:00">09:00 PM</option>
                              </select>
                            </div>
                          </div>
                          <input type="hidden" id="datetime-combined" name="date" required>
                        </div>

                        <p class="selected-datetime mt-2 mb-0 text-primary d-none">
                          <i class="fas fa-check-circle me-1"></i>
                          <span id="selected-date-display"></span>
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Location Section -->
                  <div class="form-section">
                    <div class="form-section-header">
                      <span class="section-number">2</span> Set Your Location
                    </div>
                    <div class="form-section-body">
                      <% if (addresses && addresses.length> 0) { %>
                        <div class="mb-3">
                          <label class="form-label">
                            <i class="fas fa-map-marker-alt me-2"></i>Choose Your Address
                          </label>
                          <select class="form-select" id="address-select" name="addressId">
                            <option value="">Select an address...</option>
                            <% addresses.forEach((address, index)=> { %>
                              <option value="<%= index %>" <%=address.isDefault ? 'selected' : '' %>>
                                <%= address.label %>: <%= address.street %>, <%= address.city %>, <%= address.state %> -
                                        <%= address.pincode %>
                              </option>
                              <% }); %>
                                <option value="new">+ Add a new address</option>
                          </select>
                        </div>

                        <div id="new-address-section" class="mt-3 d-none">
                          <hr>
                          <h6>Enter New Address</h6>
                          <% } %>

                            <div id="map-section" class="<%= addresses && addresses.length > 0 ? 'd-none' : '' %>">
                              <div class="mb-3">
                                <label class="form-label">
                                  <i class="fas fa-search me-2"></i>Search Location
                                </label>
                                <div class="input-group mb-2">
                                  <input type="text" id="address-input" class="form-control"
                                    placeholder="Search for your location..." />

                                  <!-- Simplified Location Button -->
                                  <button type="button" class="btn btn-outline-primary" id="detect-location-btn"
                                    title="Detect your current location">
                                    <i class="fas fa-location-arrow me-md-1"></i>
                                    <span class="d-none d-md-inline">Detect Location</span>
                                  </button>
                                </div>

                                <!-- Unified Status Display -->
                                <div id="location-status" class="mb-2 d-none">
                                  <div class="alert alert-info py-2 mb-2" role="alert">
                                    <div class="d-flex align-items-center">
                                      <div class="spinner-border spinner-border-sm me-2" role="status"
                                        id="location-spinner">
                                        <span class="visually-hidden">Loading...</span>
                                      </div>
                                      <small id="location-message">Detecting location...</small>
                                    </div>
                                  </div>
                                </div>

                                <!-- Location Methods -->
                                <div id="location-methods" class="mb-2 d-none">
                                  <div class="alert alert-warning py-2" role="alert">
                                    <small class="mb-2 d-block">
                                      <i class="fas fa-exclamation-triangle me-1"></i>
                                      <strong>Can't detect location automatically?</strong>
                                    </small>
                                    <div class="btn-group-sm" role="group">
                                      <button type="button" class="btn btn-outline-secondary btn-sm me-2"
                                        id="ip-location-btn">
                                        <i class="fas fa-globe me-1"></i>Use IP Location
                                      </button>
                                      <button type="button" class="btn btn-outline-info btn-sm" id="manual-input-btn">
                                        <i class="fas fa-keyboard me-1"></i>Enter Manually
                                      </button>
                                    </div>
                                  </div>
                                </div>

                                <div id="map" style="height: 300px; border-radius: 8px; border: 1px solid #ddd;">
                                  <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <div class="text-center">
                                      <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                                      <p>Loading map...</p>
                                      <small class="text-muted">Please wait while we initialize the map</small>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <div class="mt-3">
                              <label class="form-label">
                                <i class="fas fa-home me-2"></i>Detailed Address
                              </label>
                              <textarea id="detailed-address" name="detailedAddress" class="form-control" rows="2"
                                placeholder="Enter flat/house number, landmark, etc." required></textarea>
                            </div>

                            <% if (addresses && addresses.length> 0) { %>
                        </div>
                        <% } %>
                    </div>
                  </div>

                  <!-- Additional Info Section -->
                  <div class="form-section">
                    <div class="form-section-header">
                      <span class="section-number">3</span> Additional Information
                    </div>
                    <div class="form-section-body">
                      <div class="mb-3">
                        <label class="form-label">
                          <i class="fas fa-comment-alt me-2"></i>Special Instructions (Optional)
                        </label>
                        <textarea name="notes" class="form-control" rows="3"
                          placeholder="Any specific requirements or instructions for the service provider..."></textarea>
                      </div>
                    </div>
                  </div>

                  <!-- Booking Summary -->
                  <div class="booking-summary">
                    <div class="summary-item">
                      <div class="summary-label">Service Cost</div>
                      <div class="summary-value">₹<%= serviceDetails.customCost %>
                      </div>
                    </div>
                    <div class="summary-item">
                      <div class="summary-label">Service Charge</div>
                      <div class="summary-value">₹50</div>
                    </div>
                    <div class="summary-item total">
                      <div class="summary-label">Total Amount</div>
                      <div class="summary-value">₹<%= parseInt(serviceDetails.customCost) + 50 %>
                      </div>
                    </div>
                  </div>

                  <button type="submit" class="btn btn-primary w-100 py-3">
                    <i class="fas fa-check-circle me-2"></i>Confirm Booking
                  </button>
                </form>

                <div id="addresses-data" style="display: none;">
                  <%= JSON.stringify(addresses || []) %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="map-error" class="alert alert-danger d-none">
          Could not load Google Maps. Please refresh the page or try again later.
        </div>

        <!-- Load mapBooking.js script -->
        <script src="/js/pages/maps/mapBooking.js"></script>

        <script>
          document.addEventListener("DOMContentLoaded", function () {
            // ===== UNIFIED LOCATION MANAGER =====
            // This replaces conflicting location detection from multiple scripts

            // Prevent conflicts with other geolocation scripts
            if (window.locationDetectionInProgress) {
              console.log('🔄 Location detection already in progress, skipping...');
              return;
            }

            const UnifiedLocationManager = {
              isDetecting: false,
              hasDetected: false,

              // UI Elements
              elements: {
                detectBtn: document.getElementById('detect-location-btn'),
                ipLocationBtn: document.getElementById('ip-location-btn'),
                manualInputBtn: document.getElementById('manual-input-btn'),
                locationStatus: document.getElementById('location-status'),
                locationMessage: document.getElementById('location-message'),
                locationSpinner: document.getElementById('location-spinner'),
                locationMethods: document.getElementById('location-methods'),
                addressInput: document.getElementById('address-input'),
                detailedAddress: document.getElementById('detailed-address')
              },

              // Show status message
              showStatus: function (message, type = 'info', showSpinner = true) {
                if (this.elements.locationStatus && this.elements.locationMessage) {
                  this.elements.locationMessage.textContent = message;
                  this.elements.locationStatus.classList.remove('d-none');

                  const alertEl = this.elements.locationStatus.querySelector('.alert');
                  alertEl.className = `alert alert-${type} py-2 mb-2`;

                  if (showSpinner && this.elements.locationSpinner) {
                    this.elements.locationSpinner.classList.remove('d-none');
                  } else if (this.elements.locationSpinner) {
                    this.elements.locationSpinner.classList.add('d-none');
                  }

                  // Auto-hide success messages
                  if (type === 'success') {
                    setTimeout(() => this.hideStatus(), 4000);
                  }
                }
              },

              // Hide status
              hideStatus: function () {
                if (this.elements.locationStatus) {
                  this.elements.locationStatus.classList.add('d-none');
                }
              },

              // Show alternative methods
              showMethods: function () {
                if (this.elements.locationMethods) {
                  this.elements.locationMethods.classList.remove('d-none');
                }
              },

              // Hide alternative methods
              hideMethods: function () {
                if (this.elements.locationMethods) {
                  this.elements.locationMethods.classList.add('d-none');
                }
              },

              // Show success notification
              showSuccess: function (message) {
                // Remove any existing success alerts
                document.querySelectorAll('.location-success-alert').forEach(el => el.remove());

                const successAlert = document.createElement('div');
                successAlert.className = 'alert alert-success location-success-alert mt-2 fade show';
                successAlert.innerHTML = `
          <i class="fas fa-check-circle me-2"></i>${message}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

                const mapSection = document.getElementById('map-section');
                if (mapSection) {
                  mapSection.insertBefore(successAlert, mapSection.firstChild);
                }

                setTimeout(() => {
                  if (successAlert.parentNode) {
                    successAlert.remove();
                  }
                }, 5000);
              },

              // Main location detection method
              detectLocation: async function () {
                if (this.isDetecting || this.hasDetected) return;

                // Mark as in progress globally
                window.locationDetectionInProgress = true;
                this.isDetecting = true;

                // Update button state
                const originalText = this.elements.detectBtn.innerHTML;
                this.elements.detectBtn.disabled = true;
                this.elements.detectBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i><span class="d-none d-md-inline">Detecting...</span>';

                this.hideStatus();
                this.hideMethods();

                try {
                  // Try GPS first with better error handling
                  console.log('🔍 Starting unified location detection...');
                  await this.tryGPSLocation();
                } catch (gpsError) {
                  console.warn('📍 GPS failed, trying IP location:', gpsError.message);
                  try {
                    await this.tryIPLocation();
                  } catch (ipError) {
                    console.error('❌ All location methods failed:', ipError.message);
                    this.handleLocationFailure();
                  }
                } finally {
                  // Reset button and global state
                  this.elements.detectBtn.disabled = false;
                  this.elements.detectBtn.innerHTML = originalText;
                  this.isDetecting = false;
                  window.locationDetectionInProgress = false;
                }
              },

              // Try GPS location with single attempt (no conflicts)
              tryGPSLocation: function () {
                return new Promise((resolve, reject) => {
                  if (!navigator.geolocation) {
                    reject(new Error('Geolocation not supported'));
                    return;
                  }

                  this.showStatus('Detecting your location...', 'info', true);

                  // Single attempt with optimized settings for macOS/Safari
                  const options = {
                    enableHighAccuracy: false, // More compatible with indoor/desktop
                    timeout: 12000, // Reasonable timeout
                    maximumAge: 600000 // 10 minutes cache
                  };

                  navigator.geolocation.getCurrentPosition(
                    (position) => {
                      const lat = position.coords.latitude;
                      const lng = position.coords.longitude;
                      const accuracy = position.coords.accuracy;

                      console.log('📍 GPS location detected:', lat, lng, 'accuracy:', Math.round(accuracy), 'm');

                      this.processLocationSuccess(lat, lng, `GPS location (±${Math.round(accuracy)}m)`);
                      resolve({ lat, lng, accuracy });
                    },
                    (error) => {
                      console.warn('📍 GPS location failed:', error.message, 'Code:', error.code);
                      reject(error);
                    },
                    options
                  );
                });
              },

              // Try IP-based location
              tryIPLocation: function () {
                return new Promise(async (resolve, reject) => {
                  try {
                    this.showStatus('Getting approximate location...', 'info', true);

                    const response = await fetch('https://ipapi.co/json/', {
                      signal: AbortSignal.timeout(8000) // 8 second timeout
                    });

                    if (!response.ok) {
                      throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();

                    if (data.latitude && data.longitude && !data.error) {
                      const lat = parseFloat(data.latitude);
                      const lng = parseFloat(data.longitude);

                      console.log('📍 IP location detected:', lat, lng, 'City:', data.city);

                      this.processLocationSuccess(lat, lng, `Approximate location: ${data.city}, ${data.region}`);
                      resolve({ lat, lng, city: data.city, region: data.region });
                    } else {
                      throw new Error(data.reason || 'No location data available');
                    }
                  } catch (error) {
                    console.error('🌐 IP location failed:', error.message);
                    reject(error);
                  }
                });
              },

              // Process successful location detection
              processLocationSuccess: function (lat, lng, successMessage) {
                this.hasDetected = true;
                this.hideStatus();
                this.hideMethods();

                // Update map if available
                if (window.bookingMap && window.bookingMarker) {
                  const pos = { lat, lng };
                  window.bookingMap.setCenter(pos);
                  window.bookingMap.setZoom(17);
                  window.bookingMarker.setPosition(pos);
                }

                // Update form coordinates
                this.updateCoordinates(lat, lng);

                // Reverse geocode to get address
                this.reverseGeocode(lat, lng);

                // Show success message
                this.showSuccess(successMessage);
              },

              // Handle complete location failure
              handleLocationFailure: function () {
                this.hideStatus();
                this.showMethods();
                console.log('📍 All location detection methods failed, showing alternatives');
              },

              // Update coordinate form fields
              updateCoordinates: function (lat, lng) {
                let latInput = document.getElementById('latitude');
                let lngInput = document.getElementById('longitude');

                if (!latInput) {
                  latInput = document.createElement('input');
                  latInput.type = 'hidden';
                  latInput.id = 'latitude';
                  latInput.name = 'latitude';
                  document.getElementById('bookingForm').appendChild(latInput);
                }

                if (!lngInput) {
                  lngInput = document.createElement('input');
                  lngInput.type = 'hidden';
                  lngInput.id = 'longitude';
                  lngInput.name = 'longitude';
                  document.getElementById('bookingForm').appendChild(lngInput);
                }

                latInput.value = lat.toFixed(6);
                lngInput.value = lng.toFixed(6);

                console.log('📍 Coordinates updated:', lat.toFixed(6), lng.toFixed(6));
              },

              // Reverse geocode coordinates to address
              reverseGeocode: function (lat, lng) {
                if (window.bookingGeocoder) {
                  const latlng = { lat, lng };

                  window.bookingGeocoder.geocode({ location: latlng }, (results, status) => {
                    if (status === 'OK' && results && results[0]) {
                      const address = results[0].formatted_address;

                      if (this.elements.addressInput) {
                        this.elements.addressInput.value = address;
                        this.elements.addressInput.classList.remove('is-invalid');
                        this.elements.addressInput.classList.add('is-valid');
                      }

                      if (this.elements.detailedAddress && !this.elements.detailedAddress.value.trim()) {
                        this.elements.detailedAddress.value = address;
                        this.elements.detailedAddress.classList.remove('is-invalid');
                        this.elements.detailedAddress.classList.add('is-valid');
                      }

                      console.log('🏠 Address geocoded:', address);
                    }
                  });
                }
              }
            };

            // Event Listeners
            if (UnifiedLocationManager.elements.detectBtn) {
              UnifiedLocationManager.elements.detectBtn.addEventListener('click', () => {
                UnifiedLocationManager.detectLocation();
              });
            }

            if (UnifiedLocationManager.elements.ipLocationBtn) {
              UnifiedLocationManager.elements.ipLocationBtn.addEventListener('click', async () => {
                UnifiedLocationManager.elements.ipLocationBtn.disabled = true;
                UnifiedLocationManager.elements.ipLocationBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Getting...';

                try {
                  await UnifiedLocationManager.tryIPLocation();
                } catch (error) {
                  UnifiedLocationManager.showStatus('Could not get location via IP. Please enter manually.', 'warning', false);
                } finally {
                  UnifiedLocationManager.elements.ipLocationBtn.disabled = false;
                  UnifiedLocationManager.elements.ipLocationBtn.innerHTML = '<i class="fas fa-globe me-1"></i>Use IP Location';
                }
              });
            }

            if (UnifiedLocationManager.elements.manualInputBtn) {
              UnifiedLocationManager.elements.manualInputBtn.addEventListener('click', () => {
                UnifiedLocationManager.hideStatus();
                UnifiedLocationManager.hideMethods();
                UnifiedLocationManager.elements.addressInput.focus();
                UnifiedLocationManager.elements.addressInput.placeholder = 'Please enter your address manually...';
              });
            }

            // ===== DATE & TIME HANDLING =====
            const datePicker = document.getElementById('date-picker');
            const timePicker = document.getElementById('time-picker');
            const combinedInput = document.getElementById('datetime-combined');
            const selectedDateDisplay = document.getElementById('selected-date-display');
            const selectedDateContainer = document.querySelector('.selected-datetime');

            function formatDisplayDate(date, time) {
              if (!date) return '';
              const dateObj = new Date(date);
              const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
              const dateStr = dateObj.toLocaleDateString('en-US', options);
              return `${dateStr} at ${formatTime(time)}`;
            }

            function formatTime(timeStr) {
              if (!timeStr) return '';
              const [hours, minutes] = timeStr.split(':');
              const hour = parseInt(hours, 10);
              const ampm = hour >= 12 ? 'PM' : 'AM';
              const hour12 = hour % 12 || 12;
              return `${hour12}:${minutes} ${ampm}`;
            }

            function updateDateTime() {
              const date = datePicker.value;
              const time = timePicker.value;

              if (date && time) {
                combinedInput.value = `${date} ${time}`;
                selectedDateDisplay.textContent = formatDisplayDate(date, time);
                selectedDateContainer.classList.remove('d-none');
                datePicker.classList.add('is-valid');
                timePicker.classList.add('is-valid');
                datePicker.classList.remove('is-invalid');
                timePicker.classList.remove('is-invalid');
              } else {
                combinedInput.value = '';
                selectedDateContainer.classList.add('d-none');
              }
            }

            function updateTimeOptions() {
              const selectedDate = datePicker.value;
              const now = new Date();
              const currentDate = now.toISOString().split('T')[0];
              const isToday = selectedDate === currentDate;

              const options = Array.from(timePicker.options);
              options.forEach(option => {
                if (option.value) {
                  option.disabled = false;
                  option.style.display = '';
                }
              });

              if (isToday) {
                const currentHour = now.getHours();
                const currentMinute = now.getMinutes();
                const currentTimeValue = currentHour * 60 + currentMinute;

                options.forEach(option => {
                  if (option.value) {
                    const [hours, minutes] = option.value.split(':').map(num => parseInt(num));
                    const optionTimeValue = hours * 60 + minutes;
                    if (optionTimeValue <= currentTimeValue + 15) {
                      option.disabled = true;
                      option.style.display = 'none';
                    }
                  }
                });
              }
            }

            datePicker.addEventListener('change', function () {
              updateDateTime();
              updateTimeOptions();
            });
            timePicker.addEventListener('change', updateDateTime);
            updateTimeOptions();

            // ===== ADDRESS SELECTION HANDLING =====
            const addressSelect = document.getElementById('address-select');
            if (addressSelect) {
              const newAddressSection = document.getElementById('new-address-section');
              const mapSection = document.getElementById('map-section');
              const detailedAddressInput = document.getElementById('detailed-address');

              let addressesData = [];
              try {
                const addressDataElement = document.getElementById('addresses-data');
                if (addressDataElement) {
                  addressesData = JSON.parse(addressDataElement.textContent || '[]');
                }
              } catch (e) {
                console.error('Error parsing addresses data:', e);
              }

              addressSelect.addEventListener('change', function () {
                const selectedValue = this.value;

                if (selectedValue === 'new') {
                  if (newAddressSection) newAddressSection.classList.remove('d-none');
                  mapSection.classList.remove('d-none');
                  detailedAddressInput.value = '';

                  setTimeout(() => {
                    if (window.bookingMapManager && !window.bookingMapManager.isInitialized()) {
                      window.bookingMapManager.initBookingMapWhenReady();
                    }
                  }, 100);
                } else if (selectedValue !== '') {
                  if (newAddressSection) newAddressSection.classList.add('d-none');
                  mapSection.classList.add('d-none');

                  const addressIndex = parseInt(selectedValue);
                  if (addressesData[addressIndex]) {
                    const address = addressesData[addressIndex];
                    detailedAddressInput.value = `${address.street}, ${address.city}, ${address.state} - ${address.pincode}`;

                    // Update coordinates
                    if (address.coordinates) {
                      UnifiedLocationManager.updateCoordinates(
                        address.coordinates.latitude,
                        address.coordinates.longitude
                      );
                    }
                  }
                } else {
                  if (newAddressSection) newAddressSection.classList.add('d-none');
                  mapSection.classList.add('d-none');
                  detailedAddressInput.value = '';
                }
              });

              addressSelect.dispatchEvent(new Event('change'));
            } else {
              setTimeout(() => {
                if (window.bookingMapManager && !window.bookingMapManager.isInitialized()) {
                  window.bookingMapManager.initBookingMapWhenReady();
                }
              }, 100);
            }

            // ===== FORM VALIDATION =====
            const bookingForm = document.getElementById('bookingForm');
            if (bookingForm) {
              bookingForm.addEventListener('submit', function (e) {
                let isValid = true;

                // Date/time validation
                if (!combinedInput.value) {
                  e.preventDefault();
                  datePicker.classList.add('is-invalid');
                  timePicker.classList.add('is-invalid');
                  isValid = false;
                }

                // Location validation
                const addressInput = document.getElementById('detailed-address');
                const latitude = document.getElementById('latitude');
                const longitude = document.getElementById('longitude');

                if (!addressInput.value.trim()) {
                  e.preventDefault();
                  addressInput.classList.add('is-invalid');
                  isValid = false;
                }

                if (!latitude?.value || !longitude?.value) {
                  e.preventDefault();
                  isValid = false;
                }

                if (!isValid) {
                  alert('Please fill in all required fields and select a valid location.');
                }
              });
            }

            console.log('✅ Unified location manager initialized');
          });
        </script>

