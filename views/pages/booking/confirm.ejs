<% layout("/layouts/boilerplate.ejs") %>

<style>
  :root {
    --knf-primary: #4f46e5;
    --knf-primary-hover: #4338ca;
    --knf-primary-light: #eef2ff;
    --knf-secondary: #06b6d4;
    --knf-dark: #0f172a;
    --knf-gray: #64748b;
    --knf-gray-light: #f8fafc;
    --knf-border: #e2e8f0;
    --knf-success: #10b981;
    --knf-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    --knf-card-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .booking-confirm-wrapper {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    min-height: calc(100vh - 70px);
    padding: 2.5rem 0 4rem;
  }

  /* Stepper */
  .stepper-container {
    max-width: 620px;
    margin: 0 auto 2.5rem;
  }

  .stepper-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .step-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    background: #ffffff;
    color: var(--knf-gray);
    border: 2px solid var(--knf-border);
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
  }

  .step-node.completed .step-circle {
    background: var(--knf-success);
    border-color: var(--knf-success);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .step-node.active .step-circle {
    background: linear-gradient(135deg, var(--knf-primary) 0%, var(--knf-secondary) 100%);
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    transform: scale(1.08);
  }

  .step-title {
    margin-top: 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--knf-gray);
  }

  .step-node.active .step-title {
    color: var(--knf-primary);
    font-weight: 700;
  }

  .step-node.completed .step-title {
    color: var(--knf-dark);
  }

  .step-bar {
    flex: 1;
    height: 3px;
    background: var(--knf-border);
    margin: 0 12px 1.4rem;
    position: relative;
    border-radius: 2px;
  }

  .step-bar.filled {
    background: linear-gradient(90deg, var(--knf-success) 0%, var(--knf-primary) 100%);
  }

  /* Main Card */
  .confirm-main-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: var(--knf-card-shadow);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .confirm-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #312e81 100%);
    padding: 2.25rem 2rem;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .confirm-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .confirm-header h2 {
    font-size: 1.65rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .confirm-header p {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    font-size: 0.95rem;
  }

  .confirm-body {
    padding: 2.25rem;
  }

  /* Service Card */
  .service-showcase-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    position: relative;
    transition: all 0.2s ease;
  }

  .service-showcase-card:hover {
    border-color: #cbd5e1;
    background: #ffffff;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
  }

  .category-pill {
    position: absolute;
    top: -12px;
    left: 1.5rem;
    background: linear-gradient(135deg, var(--knf-primary) 0%, #4338ca 100%);
    color: #ffffff;
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 3px 8px rgba(79, 70, 229, 0.25);
  }

  .service-details-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.35rem;
  }

  .service-thumb {
    width: 90px;
    height: 90px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    flex-shrink: 0;
  }

  .service-info-col {
    flex: 1;
    min-width: 0;
  }

  .service-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--knf-dark);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .provider-badge-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pro-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .pro-name {
    font-weight: 600;
    color: #334155;
    font-size: 0.95rem;
    margin: 0;
  }

  .rating-tag {
    background: #fef3c7;
    color: #b45309;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .service-cost-tag {
    text-align: right;
    flex-shrink: 0;
  }

  .cost-number {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--knf-dark);
    line-height: 1.1;
  }

  .duration-number {
    font-size: 0.85rem;
    color: var(--knf-gray);
    font-weight: 500;
    margin-top: 0.2rem;
  }

  /* Booking Details Grid */
  .section-label {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--knf-dark);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .info-tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-tile {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.15rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    transition: all 0.2s ease;
  }

  .info-tile:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
  }

  .tile-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--knf-primary-light);
    color: var(--knf-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .tile-body {
    flex: 1;
    min-width: 0;
  }

  .tile-caption {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--knf-gray);
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  .tile-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--knf-dark);
    margin: 0;
    line-height: 1.35;
    word-break: break-word;
  }

  /* Payment Section */
  .payment-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .breakdown-table {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    font-size: 0.95rem;
    color: #334155;
  }

  .breakdown-row:not(:last-child) {
    border-bottom: 1px dashed #e2e8f0;
  }

  .breakdown-row.deposit-row {
    color: var(--knf-primary);
    font-weight: 700;
    font-size: 1.02rem;
  }

  .breakdown-row.balance-row {
    color: var(--knf-gray);
    font-size: 0.9rem;
  }

  .breakdown-row.total-row {
    border-top: 2px solid #e2e8f0;
    margin-top: 0.4rem;
    padding-top: 0.85rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--knf-dark);
    border-bottom: none;
  }

  /* Protection Shield Guarantee */
  .protection-banner {
    background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
    border: 1px solid #c7d2fe;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .shield-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--knf-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
    box-shadow: 0 3px 8px rgba(79, 70, 229, 0.25);
  }

  .shield-text h6 {
    font-size: 0.92rem;
    font-weight: 700;
    color: #1e1b4b;
    margin: 0 0 0.15rem;
  }

  .shield-text p {
    font-size: 0.82rem;
    color: #4338ca;
    margin: 0;
    line-height: 1.35;
  }

  /* Payment Trust Badges */
  .payment-trust-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #e2e8f0;
  }

  .methods-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.35rem;
    color: #64748b;
  }

  .ssl-guarantee {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #475569;
    font-weight: 500;
  }

  /* Action Buttons */
  .actions-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-pay-now {
    flex: 2;
    background: linear-gradient(135deg, var(--knf-primary) 0%, #4338ca 100%);
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 1.1rem 2rem;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(79, 70, 229, 0.35);
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .btn-pay-now:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(79, 70, 229, 0.45);
    background: linear-gradient(135deg, #4338ca 0%, #3730a3 100%);
    color: #ffffff;
  }

  .btn-pay-now:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .btn-back-link {
    flex: 1;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 1.1rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-back-link:hover {
    background: #f1f5f9;
    color: var(--knf-dark);
    border-color: #94a3b8;
  }

  @media (max-width: 768px) {
    .info-tiles-grid {
      grid-template-columns: 1fr;
    }
    .service-details-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .service-cost-tag {
      text-align: left;
      margin-top: 0.5rem;
    }
    .actions-group {
      flex-direction: column;
    }
    .btn-pay-now, .btn-back-link {
      width: 100%;
    }
  }
</style>

<div class="booking-confirm-wrapper">
  <div class="container">
    
    <!-- Modern Step Tracker -->
    <div class="stepper-container">
      <div class="stepper-track">
        <div class="step-node completed">
          <div class="step-circle"><i class="fas fa-check"></i></div>
          <div class="step-title">Select Service</div>
        </div>
        <div class="step-bar filled"></div>
        <div class="step-node completed">
          <div class="step-circle"><i class="fas fa-check"></i></div>
          <div class="step-title">Book Service</div>
        </div>
        <div class="step-bar filled"></div>
        <div class="step-node active">
          <div class="step-circle">3</div>
          <div class="step-title">Confirm & Pay</div>
        </div>
      </div>
    </div>

    <!-- Main Confirmation Card -->
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-9">
        <div class="confirm-main-card">
          
          <!-- Header Banner -->
          <div class="confirm-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <h2><i class="fas fa-shield-alt text-warning"></i> Confirm Your Booking</h2>
                <p>Review your booking details and reserve your slot with verified professionals</p>
              </div>
              <span class="badge bg-white bg-opacity-20 text-white border border-white border-opacity-25 px-3 py-2 rounded-pill font-monospace">
                <i class="fas fa-lock me-1"></i> 256-Bit Encrypted
              </span>
            </div>
          </div>

          <div class="confirm-body">
            
            <!-- Service & Pro Showcase -->
            <div class="service-showcase-card">
              <span class="category-pill"><%= service.category ? service.category.name : 'Home Service' %></span>
              
              <div class="service-details-row">
                <img 
                  src="<%= service.img %>" 
                  alt="<%= service.name %>" 
                  class="service-thumb"
                  onerror="this.src='https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=300'"
                />
                
                <div class="service-info-col">
                  <h3 class="service-title"><%= service.name %></h3>
                  <div class="provider-badge-group">
                    <img 
                      class="pro-avatar" 
                      src="<%= (provider.user && provider.user.profileImage && 
                              provider.user.profileImage !== 'data:;base64,=' && 
                              provider.user.profileImage.trim() !== '' && 
                              !provider.user.profileImage.includes('data:;base64,=')) 
                              ? provider.user.profileImage 
                              : 'https://cdn-icons-png.flaticon.com/512/4202/4202841.png' %>" 
                      alt="Provider"
                      onerror="this.src='https://cdn-icons-png.flaticon.com/512/4202/4202841.png'"
                    />
                    <div>
                      <p class="pro-name"><%= provider.user ? provider.user.name : 'Verified Professional' %></p>
                      <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="rating-tag"><i class="fas fa-star text-warning"></i> 4.9</span>
                        <span class="text-muted small"><i class="fas fa-check-circle text-primary me-1"></i>Verified Pro (120+ Jobs)</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="service-cost-tag">
                  <div class="cost-number">₹<%= serviceDetails.customCost %></div>
                  <div class="duration-number"><i class="far fa-clock me-1"></i><%= service.duration || 60 %> mins duration</div>
                </div>
              </div>
            </div>

            <!-- Booking Details Grid -->
            <div class="mb-4">
              <div class="section-label">
                <i class="far fa-calendar-check text-primary"></i> Service Schedule & Location
              </div>
              
              <div class="info-tiles-grid">
                <!-- Date Tile -->
                <div class="info-tile">
                  <div class="tile-icon"><i class="far fa-calendar-alt"></i></div>
                  <div class="tile-body">
                    <div class="tile-caption">Selected Date</div>
                    <p class="tile-value">
                      <%= new Date(bookingData.date).toLocaleDateString('en-US', {
                        weekday: 'short', 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric' 
                      }) %>
                    </p>
                  </div>
                </div>

                <!-- Time Tile -->
                <div class="info-tile">
                  <div class="tile-icon"><i class="far fa-clock"></i></div>
                  <div class="tile-body">
                    <div class="tile-caption">Arrival Time</div>
                    <p class="tile-value">
                      <% const bookingTime = new Date(bookingData.date).toLocaleTimeString('en-US', {
                        hour: '2-digit', 
                        minute: '2-digit', 
                        hour12: true
                      }); %>
                      <%= bookingTime %>
                    </p>
                  </div>
                </div>

                <!-- Location Tile -->
                <div class="info-tile">
                  <div class="tile-icon"><i class="fas fa-map-marker-alt"></i></div>
                  <div class="tile-body">
                    <div class="tile-caption">Service Address</div>
                    <p class="tile-value">
                      <%= bookingData.detailedAddress %>
                    </p>
                  </div>
                </div>
              </div>

              <% if (bookingData.notes) { %>
                <div class="info-tile mt-2">
                  <div class="tile-icon"><i class="far fa-sticky-note"></i></div>
                  <div class="tile-body">
                    <div class="tile-caption">Special Instructions</div>
                    <p class="tile-value text-muted"><%= bookingData.notes %></p>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Payment Summary Card -->
            <div class="payment-card">
              <div class="section-label mb-3">
                <i class="fas fa-receipt text-primary"></i> Payment Breakdown
              </div>

              <div class="breakdown-table">
                <div class="breakdown-row">
                  <span>Standard Service Fee</span>
                  <span>₹<%= serviceDetails.customCost %></span>
                </div>

                <div class="breakdown-row deposit-row">
                  <span><i class="fas fa-lock text-primary me-1"></i> Advance Booking Deposit (15%)</span>
                  <span>₹<%= Math.round(serviceDetails.customCost * 0.15) %></span>
                </div>

                <div class="breakdown-row balance-row">
                  <span>Remaining Balance (85% payable after service completion)</span>
                  <span>₹<%= Math.round(serviceDetails.customCost * 0.85) %></span>
                </div>

                <div class="breakdown-row total-row">
                  <span>Total Payable</span>
                  <span>₹<%= serviceDetails.customCost %></span>
                </div>
              </div>

              <!-- KnockNFix Protection Shield -->
              <div class="protection-banner">
                <div class="shield-icon">
                  <i class="fas fa-shield-alt"></i>
                </div>
                <div class="shield-text">
                  <h6>KnockNFix Escrow & Quality Protection</h6>
                  <p>Your 15% deposit is held safely in escrow and only released after your service is completed satisfactorily.</p>
                </div>
              </div>

              <!-- Payment Trust Bar -->
              <div class="payment-trust-bar">
                <div class="d-flex align-items-center gap-2">
                  <span class="small text-muted font-weight-bold">Accepted:</span>
                  <div class="methods-group">
                    <i class="fab fa-google-pay" title="Google Pay"></i>
                    <i class="fab fa-cc-visa" title="Visa"></i>
                    <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                    <i class="fas fa-university" title="NetBanking"></i>
                    <i class="fas fa-wallet" title="UPI & Wallets"></i>
                  </div>
                </div>
                <div class="ssl-guarantee">
                  <i class="fas fa-lock text-success"></i> Powered by Razorpay Automated Gateway
                </div>
              </div>

              <!-- Payment Flow Info hook -->
              <div id="payment-flow-info" class="payment-flow-container mt-2"></div>
            </div>

            <!-- Action Buttons -->
            <div class="actions-group">
              <button type="button" id="rzp-button" class="btn-pay-now" disabled>
                <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                <i class="fas fa-bolt me-1"></i>
                <span class="button-text">
                  Pay <span id="payment-amount">₹<%= Math.round(serviceDetails.customCost * 0.15) %></span> & Confirm Slot
                </span>
              </button>
              
              <a href="javascript:history.back()" class="btn-back-link">
                <i class="fas fa-arrow-left"></i> Modify Details
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Hidden inputs for automated payment system -->
<input type="hidden" id="payment-type" value="advance" />

<input type="hidden" id="booking-data" value='<%= JSON.stringify({
    date: bookingData.date,
    detailedAddress: bookingData.detailedAddress,
    notes: bookingData.notes || "",
    bookingId: null
}) %>' />

<input type="hidden" id="user-data" value='<%= JSON.stringify({
    name: user.name,
    email: user.username,
    phone: user.phone || "",
    razorpayKeyId: process.env.RAZORPAY_KEY_ID,
    platformAccountId: process.env.PLATFORM_ACCOUNT_ID || "platform_default_account"
}) %>' />

<input type="hidden" id="service-data" value='<%= JSON.stringify({
    serviceId: service._id,
    providerId: provider._id,
    customCost: serviceDetails.customCost,
    priceRange: serviceDetails.priceRange || null
}) %>' />

<!-- Core Payment Scripts -->
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/core/dom.js"></script>
<script src="/js/core/api.js"></script>
<script src="/js/core/notify.js"></script>
<script src="/js/pages/payment/payment.js"></script>

<script>
  // Ensure the payment button enables smoothly
  document.addEventListener('DOMContentLoaded', function () {
    const rzpButton = document.getElementById('rzp-button');
    if (!rzpButton) return;

    // Show setting up state
    rzpButton.disabled = true;
    
    setTimeout(() => {
      try {
        const serviceData = JSON.parse(document.getElementById('service-data').value);
        const depositAmount = Math.round(serviceData.customCost * 0.15);
        rzpButton.disabled = false;
        const btnText = rzpButton.querySelector('.button-text');
        if (btnText) {
          btnText.innerHTML = `Pay ₹${depositAmount} & Confirm Slot`;
        }
      } catch (err) {
        rzpButton.disabled = false;
      }
    }, 1000);
  });
</script>