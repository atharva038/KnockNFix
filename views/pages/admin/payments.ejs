<% layout("/layouts/admin-layout.ejs") %>
<div class="admin-section-header d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h4 fw-bold text-dark mb-0"><i class="fas fa-credit-card me-2 text-success"></i>Payments</h1>
    <p class="text-muted small mb-0">All payment transactions across the platform</p>
  </div>
</div>
<div class="admin-card">
  <div class="p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4 py-3 text-muted small fw-semibold">Payment ID</th>
            <th class="py-3 text-muted small fw-semibold">Booking</th>
            <th class="py-3 text-muted small fw-semibold">Type</th>
            <th class="py-3 text-muted small fw-semibold">Amount</th>
            <th class="py-3 text-muted small fw-semibold">Status</th>
            <th class="py-3 text-muted small fw-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (payments && payments.length > 0) { %>
            <% payments.forEach(function(p) { %>
              <%
                const sm = { pending:'warning', completed:'success', failed:'danger', created:'info' };
                const b = sm[p.status] || 'secondary';
              %>
              <tr>
                <td class="ps-4 py-3 font-monospace small text-muted">#<%= String(p._id).slice(-8) %></td>
                <td class="py-3 font-monospace small text-muted">
                  <%= p.booking ? '#' + String(p.booking).slice(-8) : '—' %>
                </td>
                <td class="py-3 text-capitalize"><%= p.paymentType || '—' %></td>
                <td class="py-3 fw-semibold">₹<%= p.amount %></td>
                <td class="py-3"><span class="badge bg-<%= b %>"><%= p.status %></span></td>
                <td class="py-3 text-muted small">
                  <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-IN') : 'N/A' %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="text-center text-muted py-5">No payments found</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
