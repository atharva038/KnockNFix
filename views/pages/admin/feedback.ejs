<% layout("/layouts/admin-layout.ejs") %>
<div class="admin-section-header mb-4">
  <h1 class="h4 fw-bold text-dark mb-0"><i class="fas fa-comments me-2 text-warning"></i>Feedback</h1>
  <p class="text-muted small mb-0">Customer feedback and ratings</p>
</div>
<div class="admin-card">
  <div class="p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4 py-3 text-muted small fw-semibold">Customer</th>
            <th class="py-3 text-muted small fw-semibold">Service</th>
            <th class="py-3 text-muted small fw-semibold">Rating</th>
            <th class="py-3 text-muted small fw-semibold">Comment</th>
            <th class="py-3 text-muted small fw-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (feedbacks && feedbacks.length > 0) { %>
            <% feedbacks.forEach(function(f) { %>
              <tr>
                <td class="ps-4 py-3"><%= f.customer?.name || 'N/A' %></td>
                <td class="py-3"><%= f.service?.name || 'N/A' %></td>
                <td class="py-3">
                  <% for(let i=1;i<=5;i++) { %>
                    <i class="fas fa-star <%= i <= (f.feedback?.rating || 0) ? 'text-warning' : 'text-muted' %>" style="font-size:.8rem;"></i>
                  <% } %>
                  <span class="ms-1 small"><%= f.feedback?.rating || 0 %>/5</span>
                </td>
                <td class="py-3 text-muted small" style="max-width:200px;">
                  <%= f.feedback?.comment ? f.feedback.comment.substring(0,80) + (f.feedback.comment.length > 80 ? '...' : '') : '—' %>
                </td>
                <td class="py-3 text-muted small">
                  <%= f.createdAt ? new Date(f.createdAt).toLocaleDateString('en-IN') : 'N/A' %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="text-center text-muted py-5">No feedback found</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
