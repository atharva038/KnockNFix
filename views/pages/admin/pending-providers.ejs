<% layout('/layouts/admin-layout') %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-user-clock"></i> Pending Provider Approvals
    </h1>
    <div class="text-right">
      <small class="text-muted">
        <span class="badge bg-warning"><%= providers.length %></span>
        providers awaiting approval
      </small>
    </div>
  </div>

  <!-- Providers List -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 fw-bold text-primary">
            Provider Registration Requests
          </h6>
        </div>
        <div class="card-body">
          <% if (providers && providers.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-bordered" id="providersTable">
              <thead>
                <tr>
                  <th>Provider Details</th>
                  <th>Business Address</th>
                  <th>Documents</th>
                  <th>Registration Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% providers.forEach(function(providerData) { %>
                <tr id="provider-row-<%= providerData.user._id %>">
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-3">
                        <% if (providerData.user.profileImage) { %>
                        <img src="<%= providerData.user.profileImage %>" alt="Provider" class="rounded-circle" width="50" height="50" style="object-fit: cover;">
                        <% } else { %>
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px">
                          <%= providerData.user.name.charAt(0).toUpperCase() %>
                        </div>
                        <% } %>
                      </div>
                      <div>
                        <h6 class="mb-1"><%= providerData.user.name %></h6>
                        <small class="text-muted">
                          📱 <%= providerData.user.phone %><br>
                          <% if (providerData.user.email) { %>
                          ✉️ <%= providerData.user.email %>
                          <% } %>
                        </small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if (providerData.businessAddress) { %>
                    <small>
                      <%= providerData.businessAddress.street %><br>
                      <%= providerData.businessAddress.city %>,
                      <%= providerData.businessAddress.state %><br>
                      📍 <%= providerData.businessAddress.pincode %>
                    </small>
                    <% } else { %>
                    <small class="text-muted">No address provided</small>
                    <% } %>
                  </td>
                  <td>
                    <% if (providerData.serviceProvider) { %>
                    <div>
                      <small>
                        🆔 <strong>Aadhar:</strong>
                        <% if (providerData.serviceProvider.aadharCard) { %>
                        •••••<%= providerData.serviceProvider.aadharCard.slice(-4) %>
                        <% } else { %>
                        Not provided
                        <% } %><br>
                        🏛️ <strong>PAN:</strong>
                        <%= providerData.serviceProvider.panCard || 'Not provided' %>
                      </small>
                      <br>
                      <% if (providerData.serviceProvider.aadharImage) { %>
                      <span class="badge bg-success">Aadhar Image ✓</span>
                      <% } %>
                      <% if (providerData.serviceProvider.panImage) { %>
                      <span class="badge bg-success">PAN Image ✓</span>
                      <% } %>
                    </div>
                    <% } else { %>
                    <small class="text-danger">No documents</small>
                    <% } %>
                  </td>
                  <td>
                    <small>
                      📅 <%= new Date(providerData.registrationDate).toLocaleDateString('en-IN') %><br>
                      🕒 <%= new Date(providerData.registrationDate).toLocaleTimeString('en-IN') %>
                    </small>
                  </td>
                  <td>
                    <div class="btn-group-vertical" role="group">
                      <!-- View Details Button -->
                      <button class="btn btn-info btn-sm mb-1" onclick="viewProviderDetails('<%= providerData.user._id %>')">
                        <i class="fas fa-eye"></i> View Details
                      </button>

                      <!-- Approve Button -->
                      <button class="btn btn-success btn-sm mb-1" onclick="showApprovalModal('<%= providerData.user._id %>', '<%= providerData.user.name.replace(/'/g, "\\'") %>')">
                        <i class="fas fa-check"></i> Approve
                      </button>

                      <!-- Reject Button -->
                      <button class="btn btn-danger btn-sm" onclick="showRejectionModal('<%= providerData.user._id %>', '<%= providerData.user.name.replace(/'/g, "\\'") %>')">
                        <i class="fas fa-times"></i> Reject
                      </button>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="text-center py-5">
            <i class="fas fa-user-check fa-3x text-success mb-3"></i>
            <h5 class="text-muted">No Pending Approvals</h5>
            <p class="text-muted">All providers have been reviewed!</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Provider Details Modal -->
<div class="modal fade" id="providerDetailsModal" tabindex="-1" aria-labelledby="providerDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="providerDetailsModalLabel">
          <i class="fas fa-user-circle me-2"></i>Provider Details
        </h5>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-light btn-sm d-none" id="approveFromDetailsBtn">
            <i class="fas fa-check me-1"></i>Approve
          </button>
          <button type="button" class="btn btn-outline-light btn-sm d-none" id="rejectFromDetailsBtn">
            <i class="fas fa-times me-1"></i>Reject
          </button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body p-0" id="providerDetailsContent" role="main">
        <!-- Content will be loaded dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- Image Viewer Modal -->
<div class="modal fade" id="imageViewerModal" tabindex="-1" aria-labelledby="imageViewerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="imageViewerTitle">Document Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img id="imageViewerImg" src="" alt="Document" class="img-fluid rounded shadow">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <a id="downloadImageBtn" href="" download class="btn btn-primary">
          <i class="fas fa-download"></i> Download
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Approval Modal -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title" id="approvalModalLabel">
          <i class="fas fa-check-circle me-2"></i>Approve Provider
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="approvalForm">
          <input type="hidden" id="approveProviderId" name="providerId">

          <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            You are about to approve <strong><span id="approveProviderName">Provider</span></strong>.
            Please select the permissions to grant.
          </div>

          <h6 class="mb-3">Grant Permissions:</h6>

          <div class="row">
            <div class="col-md-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantDashboardAccess" name="grantDashboardAccess" value="true" checked>
                <label class="form-check-label" for="grantDashboardAccess">
                  <strong>Dashboard Access</strong>
                  <br><small class="text-muted">Allow access to provider dashboard</small>
                </label>
              </div>

              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantServiceRegistration" name="grantServiceRegistration" value="true" checked>
                <label class="form-check-label" for="grantServiceRegistration">
                  <strong>Service Registration</strong>
                  <br><small class="text-muted">Allow adding new services</small>
                </label>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantBookingAccess" name="grantBookingAccess" value="true" checked>
                <label class="form-check-label" for="grantBookingAccess">
                  <strong>Receive Bookings</strong>
                  <br><small class="text-muted">Allow receiving customer bookings</small>
                </label>
              </div>

              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantPayoutAccess" name="grantPayoutAccess" value="true">
                <label class="form-check-label" for="grantPayoutAccess">
                  <strong>Payout Access</strong>
                  <br><small class="text-muted">Allow accessing payout features</small>
                </label>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="approvalNotes" class="form-label">Notes (Optional):</label>
            <textarea class="form-control" id="approvalNotes" name="notes" rows="3" placeholder="Add any notes about this approval..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-success" onclick="approveProvider()">
          <i class="fas fa-check me-1"></i>Approve Provider
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectionModal" tabindex="-1" aria-labelledby="rejectionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="rejectionModalLabel">
          <i class="fas fa-times-circle me-2"></i>Reject Provider
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="rejectionForm">
          <input type="hidden" id="rejectProviderId" name="providerId">

          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            You are about to reject <strong><span id="rejectProviderName">Provider</span></strong>.
            This action will prevent them from accessing the platform.
          </div>

          <div class="mb-3">
            <label for="rejectionReason" class="form-label">Rejection Reason: <span class="text-danger">*</span></label>
            <textarea class="form-control" id="rejectionReason" name="reason" rows="4" required placeholder="Please provide a detailed reason for rejection (minimum 10 characters)..."></textarea>
            <small class="text-muted">This reason will be communicated to the provider.</small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-danger" onclick="rejectProvider()">
          <i class="fas fa-times me-1"></i>Reject Provider
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// 🚀 FIXED: Robust Modal Management System
class ProviderModalManager {
  constructor() {
    this.currentModal = null;
    this.currentProvider = null;
    this.isInitialized = false;
    this.init();
  }

  init() {
    if (this.isInitialized) return;
    
    console.log('🔧 Initializing Provider Modal Manager...');
    
    // Verify required elements exist
    const requiredElements = [
      'approveProviderId',
      'approveProviderName', 
      'approvalModal',
      'rejectionModal',
      'providerDetailsModal'
    ];

    const missingElements = requiredElements.filter(id => !document.getElementById(id));
    
    if (missingElements.length > 0) {
      console.error('❌ Missing required elements:', missingElements);
      this.showAlert('error', 'System initialization failed. Please refresh the page.');
      return;
    }

    this.setupEventListeners();
    this.isInitialized = true;
    console.log('✅ Provider Modal Manager initialized successfully');
  }

  setupEventListeners() {
    // Handle modal cleanup on hide
    document.addEventListener('hidden.bs.modal', (event) => {
      const modal = event.target;
      if (modal) {
        // Remove any lingering backdrops
        document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
          if (backdrop.style.display === 'none' || !backdrop.parentNode) {
            backdrop.remove();
          }
        });
        
        // Reset body classes if needed
        if (!document.querySelector('.modal.show')) {
          document.body.classList.remove('modal-open');
          document.body.style.removeProperty('overflow');
          document.body.style.removeProperty('padding-right');
        }
      }
    });

    // Handle escape key for better UX
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && this.currentModal) {
        this.hideModal();
      }
    });
  }

  showModal(modalId) {
    try {
      const modalElement = document.getElementById(modalId);
      if (!modalElement) {
        console.error(`❌ Modal ${modalId} not found`);
        this.showAlert('error', 'Modal not found. Please refresh the page.');
        return null;
      }

      // Hide any existing modal first
      if (this.currentModal) {
        this.currentModal.hide();
        this.currentModal = null;
      }

      // Clean up any stray backdrops
      document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());

      // Create new modal instance
      const bsModal = new bootstrap.Modal(modalElement, {
        backdrop: 'static',
        keyboard: true,
        focus: true
      });

      this.currentModal = bsModal;
      modalElement.setAttribute('aria-hidden', 'false');
      bsModal.show();
      
      console.log(`✅ Modal ${modalId} shown successfully`);
      return bsModal;
    } catch (error) {
      console.error('❌ Error showing modal:', error);
      this.showAlert('error', 'Failed to open modal. Please try again.');
      return null;
    }
  }

  hideModal() {
    try {
      if (this.currentModal) {
        this.currentModal.hide();
        this.currentModal = null;
      }
      
      // Clean up DOM
      setTimeout(() => {
        document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
        document.querySelectorAll('.modal').forEach(modal => {
          modal.setAttribute('aria-hidden', 'true');
          modal.style.display = 'none';
          modal.classList.remove('show');
        });
        
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('padding-right');
      }, 150);
      
      console.log('✅ Modal hidden successfully');
    } catch (error) {
      console.error('❌ Error hiding modal:', error);
    }
  }

  showAlert(type, message) {
    // Remove existing alerts
    document.querySelectorAll('.alert-toast').forEach(alert => alert.remove());

    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

    const alertEl = document.createElement('div');
    alertEl.className = `alert ${alertClass} alert-dismissible fade show alert-toast position-fixed`;
    alertEl.style.cssText = 'top: 20px; right: 20px; z-index: 10000; min-width: 300px; max-width: 500px;';
    alertEl.innerHTML = `
      <i class="fas ${icon} me-2"></i>${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    `;

    document.body.appendChild(alertEl);

    // Auto remove after 5 seconds
    setTimeout(() => {
      if (alertEl.parentNode) {
        alertEl.remove();
      }
    }, 5000);
  }
}

// Initialize the modal manager
const modalManager = new ProviderModalManager();

// 🚀 FIXED: Show approval modal
function showApprovalModal(providerId, providerName) {
  console.log('✅ Opening approval modal for:', providerId, providerName);

  if (!modalManager.isInitialized) {
    modalManager.showAlert('error', 'System not ready. Please refresh the page.');
    return;
  }

  try {
    // Set the data with error checking
    const providerIdEl = document.getElementById('approveProviderId');
    const providerNameEl = document.getElementById('approveProviderName');
    
    if (!providerIdEl || !providerNameEl) {
      console.error('❌ Required form elements not found');
      modalManager.showAlert('error', 'Form elements missing. Please refresh the page.');
      return;
    }
    
    providerIdEl.value = providerId;
    providerNameEl.textContent = providerName;

    // Reset form with error handling
    const form = document.getElementById('approvalForm');
    if (form) {
      form.reset();
      
      // Set default checked values
      const defaultPermissions = {
        grantDashboardAccess: true,
        grantServiceRegistration: true,
        grantBookingAccess: true,
        grantPayoutAccess: false
      };
      
      Object.entries(defaultPermissions).forEach(([id, checked]) => {
        const checkbox = document.getElementById(id);
        if (checkbox) {
          checkbox.checked = checked;
        }
      });
    }

    // Show the modal
    modalManager.showModal('approvalModal');
  } catch (error) {
    console.error('❌ Error in showApprovalModal:', error);
    modalManager.showAlert('error', 'Failed to open approval modal. Please try again.');
  }
}

// 🚀 FIXED: Show rejection modal  
function showRejectionModal(providerId, providerName) {
  console.log('❌ Opening rejection modal for:', providerId, providerName);

  if (!modalManager.isInitialized) {
    modalManager.showAlert('error', 'System not ready. Please refresh the page.');
    return;
  }

  try {
    const providerIdEl = document.getElementById('rejectProviderId');
    const providerNameEl = document.getElementById('rejectProviderName');
    const reasonEl = document.getElementById('rejectionReason');

    if (!providerIdEl || !providerNameEl || !reasonEl) {
      console.error('❌ Required rejection form elements not found');
      modalManager.showAlert('error', 'Form elements missing. Please refresh the page.');
      return;
    }

    providerIdEl.value = providerId;
    providerNameEl.textContent = providerName;
    reasonEl.value = '';

    modalManager.showModal('rejectionModal');
  } catch (error) {
    console.error('❌ Error in showRejectionModal:', error);
    modalManager.showAlert('error', 'Failed to open rejection modal. Please try again.');
  }
}

// 🚀 View provider details with improved error handling
async function viewProviderDetails(providerId) {
  console.log('📋 Loading provider details for:', providerId);
  
  if (!modalManager.isInitialized) {
    modalManager.showAlert('error', 'System not ready. Please refresh the page.');
    return;
  }

  try {
    // Show modal with loading state
    modalManager.showModal('providerDetailsModal');
    
    const contentEl = document.getElementById('providerDetailsContent');
    if (contentEl) {
      contentEl.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <h5>Loading provider details...</h5>
          <p class="text-muted">Please wait while we fetch the information</p>
        </div>
      `;
    }

    const response = await fetch(`/admin/api/provider-details/${providerId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      }
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${response.statusText}`);
    }

    const data = await response.json();

    if (!data.success) {
      throw new Error(data.error || 'Failed to load provider details');
    }

    modalManager.currentProvider = data.provider;
    renderProviderDetails(data.provider);
    setupProviderActionButtons(providerId, data.provider.user.name);

  } catch (error) {
    console.error('❌ Error loading provider details:', error);
    const contentEl = document.getElementById('providerDetailsContent');
    if (contentEl) {
      contentEl.innerHTML = `
        <div class="text-center py-5">
          <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
          <h5>Error Loading Details</h5>
          <p class="text-muted">${error.message}</p>
          <button class="btn btn-primary" onclick="viewProviderDetails('${providerId}')">
            <i class="fas fa-redo me-1"></i>Try Again
          </button>
        </div>
      `;
    }
  }
}

// 🚀 Show image modal
function showImageModal(imageSrc, title) {
  try {
    const titleEl = document.getElementById('imageViewerTitle');
    const imgEl = document.getElementById('imageViewerImg');
    const downloadEl = document.getElementById('downloadImageBtn');

    if (titleEl) titleEl.textContent = title;
    if (imgEl) imgEl.src = imageSrc;
    if (downloadEl) downloadEl.href = imageSrc;

    modalManager.showModal('imageViewerModal');
  } catch (error) {
    console.error('❌ Error showing image modal:', error);
    modalManager.showAlert('error', 'Failed to show image. Please try again.');
  }
}

// 🚀 FIXED: Approve provider with comprehensive error handling
async function approveProvider() {
  if (!modalManager.isInitialized) {
    modalManager.showAlert('error', 'System not ready. Please refresh the page.');
    return;
  }

  const form = document.getElementById('approvalForm');
  const providerIdEl = document.getElementById('approveProviderId');

  if (!form || !providerIdEl) {
    modalManager.showAlert('error', 'Form data not found. Please refresh the page.');
    return;
  }

  const providerId = providerIdEl.value;
  if (!providerId) {
    modalManager.showAlert('error', 'Provider ID missing. Please try again.');
    return;
  }

  const btn = event.target;
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Approving...';
  btn.disabled = true;

  try {
    const formData = new FormData(form);
    
    // Ensure checkbox values are sent correctly
    const checkboxes = ['grantDashboardAccess', 'grantServiceRegistration', 'grantBookingAccess', 'grantPayoutAccess'];
    checkboxes.forEach(name => {
      const checkbox = document.getElementById(name);
      formData.set(name, checkbox && checkbox.checked ? 'true' : 'false');
    });

    const response = await fetch(`/admin/approve-provider/${providerId}`, {
      method: 'POST',
      body: formData,
      headers: {
        'Accept': 'application/json'
      }
    });

    if (!response.ok) {
      throw new Error(`Server error: ${response.status} ${response.statusText}`);
    }

    const data = await response.json();

    if (data.success) {
      // Remove the provider row
      const row = document.getElementById(`provider-row-${providerId}`);
      if (row) row.remove();

      modalManager.showAlert('success', data.message || 'Provider approved successfully');
      modalManager.hideModal();

      // Reload if no more providers
      const remainingRows = document.querySelectorAll('#providersTable tbody tr');
      if (remainingRows.length === 0) {
        setTimeout(() => location.reload(), 1500);
      }
    } else {
      throw new Error(data.error || 'Approval failed');
    }
  } catch (error) {
    console.error('❌ Approval error:', error);
    modalManager.showAlert('error', `Approval failed: ${error.message}`);
  } finally {
    btn.innerHTML = originalText;
    btn.disabled = false;
  }
}

// 🚀 FIXED: Reject provider with comprehensive error handling
async function rejectProvider() {
  if (!modalManager.isInitialized) {
    modalManager.showAlert('error', 'System not ready. Please refresh the page.');
    return;
  }

  const reasonEl = document.getElementById('rejectionReason');
  const providerIdEl = document.getElementById('rejectProviderId');

  if (!reasonEl || !providerIdEl) {
    modalManager.showAlert('error', 'Form elements not found. Please refresh the page.');
    return;
  }

  const reason = reasonEl.value.trim();
  const providerId = providerIdEl.value;

  if (reason.length < 10) {
    modalManager.showAlert('error', 'Rejection reason must be at least 10 characters long');
    reasonEl.focus();
    return;
  }

  const btn = event.target;
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Rejecting...';
  btn.disabled = true;

  try {
    const response = await fetch(`/admin/reject-provider/${providerId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ reason })
    });

    if (!response.ok) {
      throw new Error(`Server error: ${response.status} ${response.statusText}`);
    }

    const data = await response.json();

    if (data.success) {
      // Remove the provider row
      const row = document.getElementById(`provider-row-${providerId}`);
      if (row) row.remove();

      modalManager.showAlert('success', data.message || 'Provider rejected successfully');
      modalManager.hideModal();

      // Reload if no more providers
      const remainingRows = document.querySelectorAll('#providersTable tbody tr');
      if (remainingRows.length === 0) {
        setTimeout(() => location.reload(), 1500);
      }
    } else {
      throw new Error(data.error || 'Rejection failed');
    }
  } catch (error) {
    console.error('❌ Rejection error:', error);
    modalManager.showAlert('error', `Rejection failed: ${error.message}`);
  } finally {
    btn.innerHTML = originalText;
    btn.disabled = false;
  }
}

// Handle modal actions from details view
function handleModalAction(action, providerId, providerName) {
  modalManager.hideModal();
  
  setTimeout(() => {
    if (action === 'approve') {
      showApprovalModal(providerId, providerName);
    } else if (action === 'reject') {
      showRejectionModal(providerId, providerName);
    }
  }, 200);
}

// Setup action buttons in provider details
function setupProviderActionButtons(providerId, providerName) {
  const approveBtn = document.getElementById('approveFromDetailsBtn');
  const rejectBtn = document.getElementById('rejectFromDetailsBtn');

  if (approveBtn) {
    approveBtn.classList.remove('d-none');
    approveBtn.onclick = () => handleModalAction('approve', providerId, providerName);
  }

  if (rejectBtn) {
    rejectBtn.classList.remove('d-none');
    rejectBtn.onclick = () => handleModalAction('reject', providerId, providerName);
  }
}

