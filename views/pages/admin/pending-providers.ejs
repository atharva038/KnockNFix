  .alert-toast {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .list-group-item {
    border: none;
    padding: 0.5rem 0;
  }

  .card {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }

  .card-header {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .btn-group-vertical .btn {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>