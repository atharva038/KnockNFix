<% layout('/layouts/admin-layout') %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-user-clock"></i> Pending Provider Approvals
    </h1>
    <div class="text-right">
      <small class="text-muted">
        <span class="badge bg-warning"><%= providers.length %></span>
        providers awaiting approval
      </small>
    </div>
  </div>

  <!-- Providers List -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 fw-bold text-primary">
            Provider Registration Requests
          </h6>
        </div>
        <div class="card-body">
          <% if (providers && providers.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-bordered" id="providersTable">
              <thead>
                <tr>
                  <th>Provider Details</th>
                  <th>Business Address</th>
                  <th>Documents</th>
                  <th>Registration Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% providers.forEach(function(providerData) { %>
                <tr id="provider-row-<%= providerData.user._id %>">
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-3">
                        <% if (providerData.user.profileImage) { %>
                        <img src="<%= providerData.user.profileImage %>" alt="Provider" class="rounded-circle" width="50" height="50" style="object-fit: cover;">
                        <% } else { %>
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px">
                          <%= providerData.user.name.charAt(0).toUpperCase() %>
                        </div>
                        <% } %>
                      </div>
                      <div>
                        <h6 class="mb-1"><%= providerData.user.name %></h6>
                        <small class="text-muted">
                          📱 <%= providerData.user.phone %><br>
                          <% if (providerData.user.email) { %>
                          ✉️ <%= providerData.user.email %>
                          <% } %>
                        </small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if (providerData.businessAddress) { %>
                    <small>
                      <%= providerData.businessAddress.street %><br>
                      <%= providerData.businessAddress.city %>,
                      <%= providerData.businessAddress.state %><br>
                      📍 <%= providerData.businessAddress.pincode %>
                    </small>
                    <% } else { %>
                    <small class="text-muted">No address provided</small>
                    <% } %>
                  </td>
                  <td>
                    <% if (providerData.serviceProvider) { %>
                    <div>
                      <small>
                        🆔 <strong>Aadhar:</strong>
                        <% if (providerData.serviceProvider.aadharCard) { %>
                        •••••<%= providerData.serviceProvider.aadharCard.slice(-4) %>
                        <% } else { %>
                        Not provided
                        <% } %><br>
                        🏛️ <strong>PAN:</strong>
                        <%= providerData.serviceProvider.panCard || 'Not provided' %>
                      </small>
                      <br>
                      <% if (providerData.serviceProvider.aadharImage) { %>
                      <span class="badge bg-success">Aadhar Image ✓</span>
                      <% } %>
                      <% if (providerData.serviceProvider.panImage) { %>
                      <span class="badge bg-success">PAN Image ✓</span>
                      <% } %>
                    </div>
                    <% } else { %>
                    <small class="text-danger">No documents</small>
                    <% } %>
                  </td>
                  <td>
                    <small>
                      📅 <%= new Date(providerData.registrationDate).toLocaleDateString('en-IN') %><br>
                      🕒 <%= new Date(providerData.registrationDate).toLocaleTimeString('en-IN') %>
                    </small>
                  </td>
                  <td>
                    <div class="btn-group-vertical" role="group">
                      <!-- View Details Button -->
                      <button class="btn btn-info btn-sm mb-1" onclick="viewProviderDetails('<%= providerData.user._id %>')">
                        <i class="fas fa-eye"></i> View Details
                      </button>

                      <!-- Approve Button -->
                      <button class="btn btn-success btn-sm mb-1" onclick="showApprovalModal('<%= providerData.user._id %>', '<%= providerData.user.name.replace(/'/g, "\\'") %>')">
                        <i class="fas fa-check"></i> Approve
                      </button>

                      <!-- Reject Button -->
                      <button class="btn btn-danger btn-sm" onclick="showRejectionModal('<%= providerData.user._id %>', '<%= providerData.user.name.replace(/'/g, "\\'") %>')">
                        <i class="fas fa-times"></i> Reject
                      </button>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="text-center py-5">
            <i class="fas fa-user-check fa-3x text-success mb-3"></i>
            <h5 class="text-muted">No Pending Approvals</h5>
            <p class="text-muted">All providers have been reviewed!</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Provider Details Modal -->
<div class="modal fade" id="providerDetailsModal" tabindex="-1" aria-labelledby="providerDetailsModalLabel">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="providerDetailsModalLabel">
          <i class="fas fa-user-circle"></i> Provider Details
        </h5>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-light btn-sm" id="approveFromDetailsBtn" style="display: none;">
            <i class="fas fa-check"></i> Approve
          </button>
          <button type="button" class="btn btn-outline-light btn-sm" id="rejectFromDetailsBtn" style="display: none;">
            <i class="fas fa-times"></i> Reject
          </button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body p-0" id="providerDetailsContent">
        <!-- Content will be loaded dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- Image Viewer Modal -->
<div class="modal fade" id="imageViewerModal" tabindex="-1" aria-labelledby="imageViewerModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="imageViewerTitle">Document Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img id="imageViewerImg" src="" alt="Document" class="img-fluid rounded shadow">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <a id="downloadImageBtn" href="" download class="btn btn-primary">
          <i class="fas fa-download"></i> Download
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Approval Modal -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title" id="approvalModalLabel">
          <i class="fas fa-check-circle"></i> Approve Provider
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="approvalForm">
          <input type="hidden" id="approveProviderId" name="providerId">

          <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            You are about to approve <strong id="approveProviderName"></strong>.
            Please select the permissions to grant.
          </div>

          <h6 class="mb-3">Grant Permissions:</h6>

          <div class="row">
            <div class="col-md-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantDashboardAccess" name="grantDashboardAccess" value="true" checked>
                <label class="form-check-label" for="grantDashboardAccess">
                  <strong>Dashboard Access</strong>
                  <br><small class="text-muted">Allow access to provider dashboard</small>
                </label>
              </div>

              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantServiceRegistration" name="grantServiceRegistration" value="true" checked>
                <label class="form-check-label" for="grantServiceRegistration">
                  <strong>Service Registration</strong>
                  <br><small class="text-muted">Allow adding new services</small>
                </label>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantBookingAccess" name="grantBookingAccess" value="true" checked>
                <label class="form-check-label" for="grantBookingAccess">
                  <strong>Receive Bookings</strong>
                  <br><small class="text-muted">Allow receiving customer bookings</small>
                </label>
              </div>

              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="grantPayoutAccess" name="grantPayoutAccess" value="true">
                <label class="form-check-label" for="grantPayoutAccess">
                  <strong>Payout Access</strong>
                  <br><small class="text-muted">Allow accessing payout features</small>
                </label>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="approvalNotes" class="form-label">Notes (Optional):</label>
            <textarea class="form-control" id="approvalNotes" name="notes" rows="3" placeholder="Add any notes about this approval..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-success" onclick="approveProvider()">
          <i class="fas fa-check"></i> Approve Provider
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectionModal" tabindex="-1" aria-labelledby="rejectionModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="rejectionModalLabel">
          <i class="fas fa-times-circle"></i> Reject Provider
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="rejectionForm">
          <input type="hidden" id="rejectProviderId" name="providerId">

          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            You are about to reject <strong id="rejectProviderName"></strong>.
            This action will prevent them from accessing the platform.
          </div>

          <div class="mb-3">
            <label for="rejectionReason" class="form-label">Rejection Reason: <span class="text-danger">*</span></label>
            <textarea class="form-control" id="rejectionReason" name="reason" rows="4" required placeholder="Please provide a detailed reason for rejection (minimum 10 characters)..."></textarea>
            <small class="text-muted">This reason will be communicated to the provider.</small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-danger" onclick="rejectProvider()">
          <i class="fas fa-times"></i> Reject Provider
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // 🚀 COMPLETELY REWRITTEN - SIMPLE & WORKING MODAL SYSTEM
  let activeModal = null;
  let currentProvider = null;

  // 🔧 UTILITY: Wait for element to exist
  function waitForElement(selector, timeout = 5000) {
    return new Promise((resolve, reject) => {
      const element = document.querySelector(selector);
      if (element) {
        resolve(element);
        return;
      }

      const observer = new MutationObserver((mutations, obs) => {
        const element = document.querySelector(selector);
        if (element) {
          obs.disconnect();
          resolve(element);
        }
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true
      });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`Element ${selector} not found within ${timeout}ms`));
      }, timeout);
    });
  }

  // 🔧 SAFE MODAL SHOW - No aria manipulation
  async function safeShowModal(modalId, setupData = null) {
    try {
      console.log(`🔍 Opening modal: ${modalId}`);

      // Get modal element
      const modalElement = document.getElementById(modalId);
      if (!modalElement) {
        throw new Error(`Modal ${modalId} not found`);
      }

      // Setup modal data if provided
      if (setupData && typeof setupData === 'function') {
        const success = await setupData();
        if (!success) {
          throw new Error('Modal setup failed');
        }
      }

      // Create and show modal - let Bootstrap handle everything
      const modal = new bootstrap.Modal(modalElement, {
        backdrop: 'static',
        keyboard: true,
        focus: true
      });

      // Store reference
      activeModal = modal;

      // Show modal
      modal.show();

      console.log(`✅ Modal ${modalId} opened successfully`);
      return modal;

    } catch (error) {
      console.error(`❌ Error opening modal ${modalId}:`, error);
      showAlert('error', `Failed to open modal: ${error.message}`);
      throw error;
    }
  }

  // 🔧 SAFE MODAL HIDE
  function safeHideModal() {
    if (activeModal) {
      activeModal.hide();
      activeModal = null;
    }
  }

  // 🚀 VIEW PROVIDER DETAILS
  async function viewProviderDetails(providerId) {
    console.log('📋 Loading provider details for:', providerId);

    try {
      await safeShowModal('providerDetailsModal', async () => {
        // Show loading content
        document.getElementById('providerDetailsContent').innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <h5>Loading provider details...</h5>
          <p class="text-muted">Please wait while we fetch the information</p>
        </div>
      `;
        return true;
      });

      // Fetch provider data
      const response = await fetch(`/admin/api/provider-details/${providerId}`);

      if (!response.ok) {
        throw new Error(`API Error: ${response.status}`);
      }

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || 'Failed to load provider details');
      }

      currentProvider = data.provider;
      renderProviderDetails(data.provider);
      setupProviderActionButtons(providerId, data.provider.user.name);

      console.log('✅ Provider details loaded successfully');

    } catch (error) {
      console.error('❌ Error loading provider details:', error);
      if (document.getElementById('providerDetailsContent')) {
        document.getElementById('providerDetailsContent').innerHTML = `
        <div class="text-center py-5">
          <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
          <h5>Error Loading Details</h5>
          <p class="text-muted">${error.message}</p>
          <button class="btn btn-primary" onclick="viewProviderDetails('${providerId}')">
            <i class="fas fa-redo"></i> Try Again
          </button>
        </div>
      `;
      }
    }
  }

  // 🚀 SHOW APPROVAL MODAL
  async function showApprovalModal(providerId, providerName) {
    console.log('✅ Opening approval modal for:', providerId, providerName);

    try {
      await safeShowModal('approvalModal', async () => {
        // Wait a bit for modal to be ready
        await new Promise(resolve => setTimeout(resolve, 200));

        // Find elements with retry
        let providerIdEl, providerNameEl;
        let attempts = 0;
        const maxAttempts = 10;

        while (attempts < maxAttempts) {
          providerIdEl = document.getElementById('approveProviderId');
          providerNameEl = document.getElementById('approveProviderName');

          if (providerIdEl && providerNameEl) {
            break;
          }

          console.log(`Attempt ${attempts + 1}: Waiting for modal elements...`);
          await new Promise(resolve => setTimeout(resolve, 100));
          attempts++;
        }

        if (!providerIdEl || !providerNameEl) {
          console.error('❌ Modal elements still not found after retries');
          console.log('Available elements:', {
            approveProviderId: !!document.getElementById('approveProviderId'),
            approveProviderName: !!document.getElementById('approveProviderName'),
            approvalForm: !!document.getElementById('approvalForm')
          });
          return false;
        }

        // Set values
        providerIdEl.value = providerId;
        providerNameEl.textContent = providerName;

        // Reset form and set defaults
        const form = document.getElementById('approvalForm');
        if (form) {
          form.reset();
          // Re-check default checkboxes after reset
          const dashboardAccess = document.getElementById('grantDashboardAccess');
          const serviceReg = document.getElementById('grantServiceRegistration');
          const bookingAccess = document.getElementById('grantBookingAccess');

          if (dashboardAccess) dashboardAccess.checked = true;
          if (serviceReg) serviceReg.checked = true;
          if (bookingAccess) bookingAccess.checked = true;
        }

        console.log('✅ Approval modal setup completed');
        return true;
      });

    } catch (error) {
      console.error('❌ Error showing approval modal:', error);
      showAlert('error', 'Failed to open approval modal. Please try again.');
    }
  }

  // 🚀 SHOW REJECTION MODAL
  async function showRejectionModal(providerId, providerName) {
    console.log('❌ Opening rejection modal for:', providerId, providerName);

    try {
      await safeShowModal('rejectionModal', async () => {
        // Wait a bit for modal to be ready
        await new Promise(resolve => setTimeout(resolve, 200));

        // Find elements with retry
        let providerIdEl, providerNameEl, reasonEl;
        let attempts = 0;
        const maxAttempts = 10;

        while (attempts < maxAttempts) {
          providerIdEl = document.getElementById('rejectProviderId');
          providerNameEl = document.getElementById('rejectProviderName');
          reasonEl = document.getElementById('rejectionReason');

          if (providerIdEl && providerNameEl && reasonEl) {
            break;
          }

          console.log(`Attempt ${attempts + 1}: Waiting for rejection modal elements...`);
          await new Promise(resolve => setTimeout(resolve, 100));
          attempts++;
        }

        if (!providerIdEl || !providerNameEl || !reasonEl) {
          console.error('❌ Rejection modal elements not found after retries');
          return false;
        }

        // Set values
        providerIdEl.value = providerId;
        providerNameEl.textContent = providerName;
        reasonEl.value = '';

        console.log('✅ Rejection modal setup completed');
        return true;
      });

    } catch (error) {
      console.error('❌ Error showing rejection modal:', error);
      showAlert('error', 'Failed to open rejection modal. Please try again.');
    }
  }

  // 🚀 SHOW IMAGE MODAL
  function showImageModal(imageSrc, title) {
    console.log('🖼️ Opening image modal:', title);

    const titleEl = document.getElementById('imageViewerTitle');
    const imgEl = document.getElementById('imageViewerImg');
    const downloadEl = document.getElementById('downloadImageBtn');

    if (titleEl && imgEl && downloadEl) {
      titleEl.textContent = title;
      imgEl.src = imageSrc;
      downloadEl.href = imageSrc;

      safeShowModal('imageViewerModal');
    }
  }

  // 🚀 APPROVE PROVIDER
  async function approveProvider() {
    const form = document.getElementById('approvalForm');
    const providerId = document.getElementById('approveProviderId')?.value;

    if (!form || !providerId) {
      showAlert('error', 'Form data not found');
      return;
    }

    const btn = event.target;
    const originalText = btn.innerHTML;

    try {
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Approving...';
      btn.disabled = true;

      const formData = new FormData(form);
      const response = await fetch(`/admin/approve-provider/${providerId}`, {
        method: 'POST',
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        const row = document.getElementById(`provider-row-${providerId}`);
        if (row) row.remove();

        showAlert('success', data.message);
        safeHideModal();

        const remainingRows = document.querySelectorAll('#providersTable tbody tr');
        if (remainingRows.length === 0) {
          setTimeout(() => location.reload(), 1000);
        }
      } else {
        throw new Error(data.error || 'Failed to approve provider');
      }
    } catch (error) {
      console.error('❌ Approval error:', error);
      showAlert('error', error.message);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }

  // 🚀 REJECT PROVIDER
  async function rejectProvider() {
    const reasonEl = document.getElementById('rejectionReason');
    const providerIdEl = document.getElementById('rejectProviderId');

    if (!reasonEl || !providerIdEl) {
      showAlert('error', 'Form elements not found');
      return;
    }

    const reason = reasonEl.value.trim();
    const providerId = providerIdEl.value;

    if (reason.length < 10) {
      showAlert('error', 'Rejection reason must be at least 10 characters long');
      reasonEl.focus();
      return;
    }

    const btn = event.target;
    const originalText = btn.innerHTML;

    try {
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rejecting...';
      btn.disabled = true;

      const response = await fetch(`/admin/reject-provider/${providerId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          reason
        })
      });

      const data = await response.json();

      if (data.success) {
        const row = document.getElementById(`provider-row-${providerId}`);
        if (row) row.remove();

        showAlert('success', data.message);
        safeHideModal();

        const remainingRows = document.querySelectorAll('#providersTable tbody tr');
        if (remainingRows.length === 0) {
          setTimeout(() => location.reload(), 1000);
        }
      } else {
        throw new Error(data.error || 'Failed to reject provider');
      }
    } catch (error) {
      console.error('❌ Rejection error:', error);
      showAlert('error', error.message);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }

  // 🚀 HANDLE MODAL ACTIONS
  function handleModalAction(action, providerId, providerName) {
    console.log(`🎯 Handling ${action} for provider:`, providerId, providerName);

    if (action === 'approve') {
      showApprovalModal(providerId, providerName);
    } else if (action === 'reject') {
      showRejectionModal(providerId, providerName);
    }
  }

  // 🚀 SETUP PROVIDER ACTION BUTTONS
  function setupProviderActionButtons(providerId, providerName) {
    const approveBtn = document.getElementById('approveFromDetailsBtn');
    const rejectBtn = document.getElementById('rejectFromDetailsBtn');

    if (approveBtn) {
      approveBtn.style.display = 'inline-block';
      approveBtn.onclick = () => handleModalAction('approve', providerId, providerName);
    }

    if (rejectBtn) {
      rejectBtn.style.display = 'inline-block';
      rejectBtn.onclick = () => handleModalAction('reject', providerId, providerName);
    }
  }

  // 🎨 RENDER PROVIDER DETAILS
  function renderProviderDetails(provider) {
    const content = `
    <div class="container-fluid p-4">
      <!-- Status Header -->
      <div class="alert alert-warning mb-4">
        <div class="d-flex justify-content-between align-items-center">
          <span><i class="fas fa-clock"></i> <strong>Pending Approval</strong></span>
          <small class="text-muted">Registered: ${formatDate(provider.registrationDate)}</small>
        </div>
      </div>

      <div class="row g-4">
        <!-- Basic Info -->
        <div class="col-lg-4">
          <div class="card h-100">
            <div class="card-header bg-primary text-white">
              <i class="fas fa-user"></i> Basic Information
            </div>
            <div class="card-body text-center">
              ${renderProfileImage(provider.user)}
              <h5 class="mt-3">${provider.user.name}</h5>
              <div class="mt-3">
                ${renderBasicInfo(provider.user)}
              </div>
            </div>
          </div>
        </div>

        <!-- Business Info -->
        <div class="col-lg-8">
          <div class="card h-100">
            <div class="card-header bg-info text-white">
              <i class="fas fa-building"></i> Business Information
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <h6 class="text-primary">Business Details</h6>
                  ${renderBusinessInfo(provider.serviceProvider)}
                </div>
                <div class="col-md-6">
                  <h6 class="text-primary">Business Address</h6>
                  ${renderAddressInfo(provider.businessAddress)}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Documents -->
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-warning text-dark">
              <i class="fas fa-file-alt"></i> Document Verification
            </div>
            <div class="card-body">
              ${renderDocuments(provider.serviceProvider)}
            </div>
          </div>
        </div>

        ${provider.services && provider.services.length > 0 ? `
        <!-- Services -->
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-success text-white">
              <i class="fas fa-tools"></i> Registered Services
            </div>
            <div class="card-body">
              ${renderServices(provider.services)}
            </div>
          </div>
        </div>
        ` : ''}
      </div>

      <!-- Action Buttons -->
      <div class="text-center mt-4 pt-4 border-top">
        <button class="btn btn-success btn-lg me-2" onclick="handleModalAction('approve', '${provider.user._id}', '${escapeQuotes(provider.user.name)}')">
          <i class="fas fa-check"></i> Approve Provider
        </button>
        <button class="btn btn-danger btn-lg me-2" onclick="handleModalAction('reject', '${provider.user._id}', '${escapeQuotes(provider.user.name)}')">
          <i class="fas fa-times"></i> Reject Provider
        </button>
        <button class="btn btn-secondary btn-lg" onclick="safeHideModal()">
          <i class="fas fa-arrow-left"></i> Close
        </button>
      </div>
    </div>
  `;

    document.getElementById('providerDetailsContent').innerHTML = content;
  }

  // 🔧 HELPER RENDERING METHODS
  function renderProfileImage(user) {
    if (user.profileImage) {
      return `<img src="${user.profileImage}" alt="Profile" class="rounded-circle" width="100" height="100" style="object-fit: cover; cursor: pointer;" onclick="showImageModal('${user.profileImage}', 'Profile Picture')">`;
    } else {
      return `<div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto" style="width: 100px; height: 100px; font-size: 2rem; font-weight: bold;">${user.name.charAt(0).toUpperCase()}</div>`;
    }
  }

  function renderBasicInfo(user) {
    return `
    <div class="list-group list-group-flush">
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-phone text-primary me-2"></i>
        <span><strong>Phone:</strong> ${user.phone}</span>
      </div>
      ${user.email ? `
        <div class="list-group-item d-flex align-items-center">
          <i class="fas fa-envelope text-primary me-2"></i>
          <span><strong>Email:</strong> ${user.email}</span>
        </div>
      ` : ''}
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-venus-mars text-primary me-2"></i>
        <span><strong>Gender:</strong> ${user.gender || 'Not specified'}</span>
      </div>
      ${user.dateOfBirth ? `
        <div class="list-group-item d-flex align-items-center">
          <i class="fas fa-birthday-cake text-primary me-2"></i>
          <span><strong>DOB:</strong> ${formatDate(user.dateOfBirth)}</span>
        </div>
      ` : ''}
    </div>
  `;
  }

  function renderBusinessInfo(serviceProvider) {
    if (!serviceProvider) {
      return '<div class="alert alert-warning">No business information provided</div>';
    }

    return `
    <div class="list-group list-group-flush">
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-store text-info me-2"></i>
        <span><strong>Business:</strong> ${serviceProvider.businessName || 'Not provided'}</span>
      </div>
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-tools text-info me-2"></i>
        <span><strong>Experience:</strong> ${serviceProvider.experience || 'Not specified'} years</span>
      </div>
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-certificate text-info me-2"></i>
        <span><strong>Skills:</strong> ${renderSkills(serviceProvider.skills)}</span>
      </div>
      ${serviceProvider.description ? `
        <div class="list-group-item">
          <i class="fas fa-info-circle text-info me-2"></i>
          <span><strong>Description:</strong> ${serviceProvider.description}</span>
        </div>
      ` : ''}
    </div>
  `;
  }

  function renderAddressInfo(address) {
    if (!address) {
      return '<div class="alert alert-warning">No address provided</div>';
    }

    return `
    <div class="list-group list-group-flush">
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-road text-info me-2"></i>
        <span><strong>Street:</strong> ${address.street}</span>
      </div>
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-city text-info me-2"></i>
        <span><strong>City:</strong> ${address.city}</span>
      </div>
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-flag text-info me-2"></i>
        <span><strong>State:</strong> ${address.state}</span>
      </div>
      <div class="list-group-item d-flex align-items-center">
        <i class="fas fa-mail-bulk text-info me-2"></i>
        <span><strong>Pincode:</strong> ${address.pincode}</span>
      </div>
      ${address.landmark ? `
        <div class="list-group-item d-flex align-items-center">
          <i class="fas fa-map-pin text-info me-2"></i>
          <span><strong>Landmark:</strong> ${address.landmark}</span>
        </div>
      ` : ''}
    </div>
  `;
  }

  function renderDocuments(serviceProvider) {
    if (!serviceProvider) {
      return '<div class="alert alert-danger">No documents submitted</div>';
    }

    return `
    <div class="row g-3">
      <div class="col-md-6">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-id-card"></i> Aadhar Card</h6>
            ${getDocumentStatus(serviceProvider.aadharCard, serviceProvider.aadharImage)}
          </div>
          <div class="card-body">
            <p><strong>Number:</strong> ${serviceProvider.aadharCard ? `•••• •••• •••• ${serviceProvider.aadharCard.slice(-4)}` : 'Not provided'}</p>
            ${renderDocumentImage(serviceProvider.aadharImage, 'Aadhar Card')}
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-credit-card"></i> PAN Card</h6>
            ${getDocumentStatus(serviceProvider.panCard, serviceProvider.panImage)}
          </div>
          <div class="card-body">
            <p><strong>Number:</strong> ${serviceProvider.panCard || 'Not provided'}</p>
            ${renderDocumentImage(serviceProvider.panImage, 'PAN Card')}
          </div>
        </div>
      </div>
    </div>
  `;
  }

  function renderServices(services) {
    return `
    <div class="row g-3">
      ${services.map(service => `
        <div class="col-lg-4 col-md-6">
          <div class="card">
            <div class="card-body">
              <h6 class="card-title">${service.name}</h6>
              <p class="card-text text-muted">${service.description}</p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="h6 text-primary mb-0">₹${service.price}</span>
                <span class="badge bg-info">${service.category.name}</span>
              </div>
            </div>
          </div>
        </div>
      `).join('')}
    </div>
  `;
  }

  function renderSkills(skills) {
    if (!skills || skills.length === 0) return 'Not specified';
    return skills.map(skill => `<span class="badge bg-secondary me-1">${skill}</span>`).join('');
  }

  function getDocumentStatus(docNumber, docImage) {
    if (docNumber && docImage) {
      return '<span class="badge bg-success"><i class="fas fa-check"></i> Complete</span>';
    } else {
      return '<span class="badge bg-danger"><i class="fas fa-times"></i> Incomplete</span>';
    }
  }

  function renderDocumentImage(imageSrc, title) {
    if (imageSrc) {
      return `
      <div class="text-center">
        <img src="${imageSrc}" alt="${title}" class="img-thumbnail" style="width: 200px; height: 120px; object-fit: cover; cursor: pointer;" onclick="showImageModal('${imageSrc}', '${title}')">
        <br><small class="text-muted">Click to view full image</small>
      </div>
    `;
    } else {
      return '<div class="alert alert-warning">No image uploaded</div>';
    }
  }

  function formatDate(dateString) {
    return new Date(dateString).toLocaleDateString('en-IN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }

  function escapeQuotes(str) {
    return str.replace(/'/g, "\\'");
  }

  // 🚀 SHOW ALERT
  function showAlert(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

    // Remove existing alerts
    document.querySelectorAll('.alert-toast').forEach(alert => alert.remove());

    const alertEl = document.createElement('div');
    alertEl.className = `alert ${alertClass} alert-dismissible fade show alert-toast position-fixed`;
    alertEl.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
    alertEl.innerHTML = `
    <i class="fas ${icon}"></i> ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;

    document.body.appendChild(alertEl);

    // Auto remove after 5 seconds
    setTimeout(() => {
      if (alertEl.parentNode) {
        const bsAlert = new bootstrap.Alert(alertEl);
        bsAlert.close();
      }
    }, 5000);
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🎉 Provider Management System initialized successfully!');

    // Remove any lingering aria-hidden attributes on page load
    document.querySelectorAll('.modal[aria-hidden="true"]').forEach(modal => {
      if (!modal.classList.contains('show')) {
        modal.removeAttribute('aria-hidden');
      }
    });
  });

  // Override Bootstrap's aria-hidden behavior
  document.addEventListener('show.bs.modal', function(e) {
    console.log(`🔍 Modal ${e.target.id} is showing`);
    e.target.removeAttribute('aria-hidden');
  });

  document.addEventListener('hide.bs.modal', function(e) {
    console.log(`🔍 Modal ${e.target.id} is hiding`);
    // Don't set aria-hidden manually - let Bootstrap handle it naturally
  });
</script>

