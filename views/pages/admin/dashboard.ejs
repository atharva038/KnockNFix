<% layout("/layouts/admin-layout.ejs") %>

<div class="admin-section-header">
  <h1 class="h4 fw-bold text-dark">Dashboard Overview</h1>
  <p class="text-muted small mb-0">Welcome back, <%= currUser?.name || 'Admin' %></p>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="admin-card p-4">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small fw-semibold text-uppercase mb-1">Total Bookings</p>
          <h3 class="fw-bold mb-0"><%= totalBookings || 0 %></h3>
        </div>
        <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10"
          style="width:56px;height:56px;">
          <i class="fas fa-calendar-check text-primary fs-4"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-card p-4">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small fw-semibold text-uppercase mb-1">Total Users</p>
          <h3 class="fw-bold mb-0"><%= totalUsers || 0 %></h3>
        </div>
        <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10"
          style="width:56px;height:56px;">
          <i class="fas fa-users text-success fs-4"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-card p-4">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small fw-semibold text-uppercase mb-1">Total Providers</p>
          <h3 class="fw-bold mb-0"><%= totalProviders || 0 %></h3>
        </div>
        <div class="d-flex align-items-center justify-content-center rounded-circle bg-info bg-opacity-10"
          style="width:56px;height:56px;">
          <i class="fas fa-user-tie text-info fs-4"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-card p-4">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small fw-semibold text-uppercase mb-1">Total Services</p>
          <h3 class="fw-bold mb-0"><%= totalServices || 0 %></h3>
        </div>
        <div class="d-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10"
          style="width:56px;height:56px;">
          <i class="fas fa-tools text-warning fs-4"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Bookings -->
<div class="admin-card">
  <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
    <h5 class="fw-bold mb-0">Recent Bookings</h5>
    <a href="/admin/bookings" class="btn btn-outline-primary btn-sm">View All</a>
  </div>
  <div class="p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4 py-3 text-muted small fw-semibold">Booking ID</th>
            <th class="py-3 text-muted small fw-semibold">Customer</th>
            <th class="py-3 text-muted small fw-semibold">Service</th>
            <th class="py-3 text-muted small fw-semibold">Provider</th>
            <th class="py-3 text-muted small fw-semibold">Status</th>
            <th class="py-3 text-muted small fw-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentBookings && recentBookings.length > 0) { %>
            <% recentBookings.forEach(function(b) { %>
              <%
                const statusMap = { pending:'warning', confirmed:'info', in_progress:'primary', completed:'success', cancelled:'danger' };
                const badge = statusMap[b.status] || 'secondary';
              %>
              <tr>
                <td class="ps-4 py-3">
                  <span class="text-muted small font-monospace">#<%= String(b._id).slice(-8) %></span>
                </td>
                <td class="py-3"><%= b.customer?.name || 'N/A' %></td>
                <td class="py-3"><%= b.service?.name || 'N/A' %></td>
                <td class="py-3"><%= b.provider?.user?.name || 'N/A' %></td>
                <td class="py-3">
                  <span class="badge bg-<%= badge %> text-capitalize"><%= (b.status || 'unknown').replace('_',' ') %></span>
                </td>
                <td class="py-3 text-muted small">
                  <%= b.createdAt ? new Date(b.createdAt).toLocaleDateString('en-IN') : 'N/A' %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">No recent bookings found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
