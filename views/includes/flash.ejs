<!-- Toastify JS CSS & Script -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Reusable function to create stylish toasts
    function showToast(message, type) {
      if (!message) return;
      
      const isError = type === 'error';
      
      Toastify({
        text: message,
        duration: isError ? 6000 : 4000,
        close: true,
        gravity: "top", // `top` or `bottom`
        position: "right", // `left`, `center` or `right`
        stopOnFocus: true, // Prevents dismissing of toast on hover
        style: {
          background: isError ? "linear-gradient(to right, #ef4444, #f87171)" : "linear-gradient(to right, #10b981, #34d399)",
          color: "white",
          borderRadius: "12px",
          boxShadow: "0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
          fontFamily: "'Inter', 'Plus Jakarta Sans', sans-serif",
          fontWeight: "500",
          maxWidth: "400px",
          padding: "14px 20px",
          wordBreak: "break-word",
          display: "flex",
          alignItems: "center",
          gap: "8px",
          zIndex: 9999
        },
        escapeMarkup: false
      }).showToast();
    }

    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <% success.forEach(function(msg) { %>
        // Safe string escaping for EJS to JS
        showToast(`<%- msg.toString().replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\n/g, '\\n') %>`, 'success');
      <% }); %>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <% error.forEach(function(msg) { %>
        showToast(`<%- msg.toString().replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\n/g, '\\n') %>`, 'error');
      <% }); %>
    <% } %>
  });
</script>
