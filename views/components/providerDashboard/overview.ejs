<div
  class="modal fade"
  id="viewBookingModal"
  tabindex="-1"
  aria-labelledby="viewBookingModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="viewBookingModalLabel">Booking Details</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <div class="booking-details-container">
          <div class="row booking-header">
            <div class="col-md-8">
              <h3 id="modal-service-name">Loading...</h3>
              <p class="provider-name">
                <i class="fas fa-user me-2"></i>
                <span id="modal-customer-name">Loading...</span>
              </p>
            </div>
            <div class="col-md-4 text-end">
              <span id="modal-booking-status" class="status-badge"
                >Loading...</span
              >
            </div>
          </div>

          <div class="row mt-4">
            <div class="col-md-6">
              <div class="detail-group">
                <label>Booking Date</label>
                <p id="modal-booking-date">Loading...</p>
              </div>

              <div class="detail-group">
                <label>Booking Address</label>
                <p id="modal-booking-address">Loading...</p>
              </div>

              <div class="detail-group">
                <label>Notes</label>
                <p id="modal-booking-notes">Loading...</p>
              </div>
            </div>

            <div class="col-md-6">
              <div class="detail-group">
                <label>Total Cost</label>
                <h4 id="modal-booking-cost">Loading...</h4>
              </div>

              <div class="detail-group">
                <label>Payment Status</label>
                <p id="modal-payment-status">Loading...</p>
              </div>

              <div class="detail-group">
                <label>Customer Contact</label>
                <p>
                  Phone: <span id="modal-customer-phone">Not provided</span>
                </p>
                <p>
                  Email: <span id="modal-customer-email">Not provided</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Close
        </button>
        <div id="modal-action-buttons">
          <!-- Action buttons will be injected here based on booking status -->
        </div>
      </div>
    </div>
  </div>
</div>
<section id="overview" class="dashboard-section active">
  <!-- Greeting and Overview -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <h2 class="fs-4 fw-bold text-dark mb-0">Welcome, <%= user.name %></h2>
    <div class="btn-group">
      <button class="btn btn-outline-primary rounded">
        <i class="fas fa-download me-2"></i>Export Report
      </button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row g-4 mb-4">
    <!-- Total Bookings -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 transition-hover bg-white">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle shadow-sm" style="width: 48px; height: 48px;">
            <i class="fas fa-calendar-check fs-5"></i>
          </div>
          <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">
            <i class="fas fa-arrow-up me-1"></i><%= bookingStats.increase || 0 %>%
          </span>
        </div>
        <h5 class="text-secondary fw-semibold fs-6 mb-1 text-uppercase letter-spacing-1">Total Bookings</h5>
        <h2 class="fw-bold text-dark mb-0 fs-1"><%= bookingStats.total || 0 %></h2>
      </div>
    </div>

    <!-- Ongoing Services -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 transition-hover bg-white">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle shadow-sm" style="width: 48px; height: 48px;">
            <i class="fas fa-tools fs-5"></i>
          </div>
          <span class="badge bg-light text-secondary rounded-pill px-2 py-1">Active Now</span>
        </div>
        <h5 class="text-secondary fw-semibold fs-6 mb-1 text-uppercase letter-spacing-1">Ongoing Services</h5>
        <h2 class="fw-bold text-dark mb-0 fs-1"><%= bookingStats.ongoing || 0 %></h2>
      </div>
    </div>

    <!-- Average Rating -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-4 transition-hover bg-white">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div class="d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle shadow-sm" style="width: 48px; height: 48px;">
            <i class="fas fa-star fs-5"></i>
          </div>
          <div class="text-warning fs-6">
            <% for (let i = 1; i <= 5; i++) { %> 
              <% if (i <= Math.floor(ratings.average || 0)) { %>
                <i class="fas fa-star"></i>
              <% } else if (i - 0.5 <= (ratings.average || 0)) { %>
                <i class="fas fa-star-half-alt"></i>
              <% } else { %>
                <i class="far fa-star text-light"></i>
              <% } %> 
            <% } %>
          </div>
        </div>
        <h5 class="text-secondary fw-semibold fs-6 mb-1 text-uppercase letter-spacing-1">Average Rating</h5>
        <h2 class="fw-bold text-dark mb-0 fs-1"><%= ratings.average || 0 %></h2>
      </div>
    </div>
  </div>

  <!-- Recent Bookings Preview -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold fs-5"><i class="fas fa-list-alt text-primary me-2"></i>Recent Bookings</h5>
      <a href="#bookings" class="btn btn-sm btn-outline-primary px-3 rounded-pill" data-section="bookings">View All</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-secondary small text-uppercase">
          <tr>
            <th class="ps-4 py-3 fw-semibold">Service</th>
            <th class="py-3 fw-semibold">Date</th>
            <th class="py-3 fw-semibold">Client</th>
            <th class="py-3 fw-semibold">Status</th>
            <th class="pe-4 py-3 fw-semibold text-end">Action</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% if (bookings && bookings.length > 0) { %>
            <% bookings.slice(0, 5).forEach(booking => { %>
            <tr>
              <td class="ps-4 py-3 fw-medium text-dark">
                <%= (booking.service && booking.service.name) ? booking.service.name : 'N/A' %>
              </td>
              <td class="py-3 text-secondary">
                <% try { %> <%= new Date(booking.bookingDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %> <% } catch(e) { %> N/A <% } %>
              </td>
              <td class="py-3 text-dark fw-medium">
                <%= (booking.customer && booking.customer.name) ? booking.customer.name : 'N/A' %>
              </td>
              <td class="py-3">
                <span class="badge rounded-pill px-3 py-2 text-uppercase fw-bold
                  <%= booking.status.toLowerCase() === 'pending' ? 'bg-warning text-dark' : 
                      booking.status.toLowerCase() === 'confirmed' ? 'bg-info text-dark' : 
                      booking.status.toLowerCase() === 'completed' ? 'bg-success' : 
                      booking.status.toLowerCase() === 'cancelled' ? 'bg-danger' : 'bg-secondary' %>">
                  <%= booking.status %>
                </span>
              </td>
              <td class="pe-4 py-3 text-end">
                <div class="d-flex gap-2 justify-content-end">
                  <button class="btn btn-sm btn-light border text-primary rounded-circle view-booking" data-id="<%= booking._id %>" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;" title="View Details">
                    <i class="fas fa-eye"></i>
                  </button>
                  <% if (booking.status === 'pending') { %>
                  <button class="btn btn-sm btn-light border text-success rounded-circle accept-booking" data-id="<%= booking._id %>" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;" title="Accept">
                    <i class="fas fa-check"></i>
                  </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="fas fa-inbox fs-2 mb-3 text-light"></i>
                <p class="mb-0">No recent bookings found.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
