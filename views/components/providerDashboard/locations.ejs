<div class="dashboard-section" id="locations-section" style="display: none;">
    <div class="section-header d-flex justify-content-between align-items-center mb-3">
        <h2 class="fs-4 mb-0"><i class="fas fa-map-marker-alt me-2"></i> Service Locations</h2>
        <button type="button" class="btn btn-sm btn-primary" id="saveAllLocationSettings">
            <i class="fas fa-save me-1"></i>Save All Changes
        </button>
    </div>

    <!-- Service Area Section -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <h5 class="mb-0 fs-5">General Service Coverage</h5>
        </div>
        <div class="card-body py-3">
            <div class="alert alert-info py-2 px-3 mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <small>Set your service area to specify how far you're willing to travel for bookings.</small>
            </div>

            <form id="serviceAreaForm">
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label for="service-radius" class="form-label small">Service Radius</label>
                        <div class="input-group input-group-sm">
                            <% if (provider && provider.serviceArea && provider.serviceArea.radius) { %>
                                <input type="number" class="form-control" id="service-radius" name="radius" value="<%= provider.serviceArea.radius %>" min="1" max="100">
                            <% } else { %>
                                <input type="number" class="form-control" id="service-radius" name="radius" value="20" min="1" max="100">
                            <% } %>
                            <span class="input-group-text">km</span>
                        </div>
                        <small class="text-muted fs-7">Maximum distance you're willing to travel</small>
                    </div>

                    <div class="col-md-6">
                        <label for="service-city" class="form-label small">Based In (City)</label>
                        <% if (provider && provider.serviceArea && provider.serviceArea.city) { %>
                            <input type="text" class="form-control form-control-sm" id="service-city" name="city" value="<%= provider.serviceArea.city %>" placeholder="Your city">
                        <% } else { %>
                            <input type="text" class="form-control form-control-sm" id="service-city" name="city" value="" placeholder="Your city">
                        <% } %>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label for="service-state" class="form-label small">State</label>
                        <% if (provider && provider.serviceArea && provider.serviceArea.state) { %>
                            <input type="text" class="form-control form-control-sm" id="service-state" name="state" value="<%= provider.serviceArea.state %>">
                        <% } else { %>
                            <input type="text" class="form-control form-control-sm" id="service-state" name="state" value="">
                        <% } %>
                    </div>

                    <div class="col-md-6">
                        <label for="service-pincode" class="form-label small">PIN Code</label>
                        <% if (provider && provider.serviceArea && provider.serviceArea.pincode) { %>
                            <input type="text" class="form-control form-control-sm" id="service-pincode" name="pincode" value="<%= provider.serviceArea.pincode %>" pattern="[0-9]{6}">
                        <% } else { %>
                            <input type="text" class="form-control form-control-sm" id="service-pincode" name="pincode" value="" pattern="[0-9]{6}">
                        <% } %>
                    </div>
                </div>

                <button type="button" class="btn btn-sm btn-primary" id="saveServiceAreaBtn">
                    <i class="fas fa-save me-1"></i>Save Service Area
                </button>
            </form>
        </div>
    </div>

    <!-- Availability Settings -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <h5 class="mb-0 fs-5">Availability Settings</h5>
        </div>
        <div class="card-body py-3">
            <div class="alert alert-info py-2 px-3 mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <small>Set your working hours to determine when you're available for bookings.</small>
            </div>
            <form id="availabilityForm">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <% if (provider && provider.isActive) { %>
                            <input class="form-check-input" type="checkbox" id="overall-availability" checked>
                        <% } else { %>
                            <input class="form-check-input" type="checkbox" id="overall-availability">
                        <% } %>
                        <label class="form-check-label small fw-bold" for="overall-availability">
                            Active Status (When turned off, you will not be visible to customers)
                        </label>
                    </div>
                </div>

                <%
                var days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
                for (var i = 0; i < days.length; i++) {
                    var day = days[i];
                    var dayData = { isAvailable: true, slots: [] };
                    if (provider && provider.availability && provider.availability[day]) {
                        dayData = provider.availability[day];
                    }
                    
                    if (dayData.slots.length === 0) {
                        dayData.slots.push({
                            startTime: "07:00",
                            endTime: "21:00",
                            isActive: true
                        });
                    }
                %>
                    <div class="day-container mb-2 p-2 border-bottom" data-day="<%= day %>">
                        <div class="day-header d-flex align-items-center mb-2">
                            <div class="form-check form-switch">
                                <% if (dayData.isAvailable) { %>
                                    <input class="form-check-input day-toggle" type="checkbox" id="<%= day %>-available" data-day="<%= day %>" checked>
                                <% } else { %>
                                    <input class="form-check-input day-toggle" type="checkbox" id="<%= day %>-available" data-day="<%= day %>">
                                <% } %>
                                <label class="form-check-label small fw-bold text-capitalize" for="<%= day %>-available">
                                    <%= day %>
                                </label>
                            </div>
                            <button type="button" class="btn btn-xs btn-outline-primary ms-auto add-slot-btn" data-day="<%= day %>">
                                <i class="fas fa-plus me-1"></i> Add Slot
                            </button>
                        </div>

                        <% if (!dayData.isAvailable) { %>
                            <div class="slots-container" id="<%= day %>-slots" style="display:none">
                        <% } else { %>
                            <div class="slots-container" id="<%= day %>-slots">
                        <% } %>
                            <% for (var j = 0; j < dayData.slots.length; j++) {
                                var slot = dayData.slots[j];
                                var index = j;
                            %>
                                <div class="slot-row d-flex align-items-center mb-2" data-index="<%= index %>">
                                    <div class="time-range flex-grow-1">
                                        <div class="input-group input-group-sm">
                                            <input type="time" class="form-control slot-start" value="<%= slot.startTime %>" name="<%= day %>-start-<%= index %>" required>
                                            <span class="input-group-text">to</span>
                                            <input type="time" class="form-control slot-end" value="<%= slot.endTime %>" name="<%= day %>-end-<%= index %>" required>
                                        </div>
                                    </div>
                                    <div class="form-check form-switch ms-2 me-1">
                                        <% if (slot.isActive) { %>
                                            <input class="form-check-input slot-active" type="checkbox" id="<%= day %>-slot-<%= index %>-active" checked>
                                        <% } else { %>
                                            <input class="form-check-input slot-active" type="checkbox" id="<%= day %>-slot-<%= index %>-active">
                                        <% } %>
                                        <label class="form-check-label small" for="<%= day %>-slot-<%= index %>-active">Active</label>
                                    </div>
                                    <% if (index > 0) { %>
                                        <button type="button" class="btn btn-xs btn-outline-danger remove-slot-btn">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <button type="button" class="btn btn-sm btn-primary mt-2" id="saveAvailabilityBtn">
                    <i class="fas fa-save me-1"></i>Save Availability Settings
                </button>
            </form>
        </div>
    </div>

    <!-- Service Locations Map -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <h5 class="mb-0 fs-5">Specific Service Locations</h5>
        </div>
        <div class="card-body py-3">
            <div class="alert alert-info py-2 px-3 mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <small>Add specific locations where you offer services. Each location can have its own custom radius.</small>
            </div>
            <div class="location-manager">
                <div class="current-locations mb-3">
                    <h6 class="fs-6 mb-2">Current Service Areas</h6>
                    <div id="existing-service-areas" class="border rounded p-2 bg-light">
                        <% if (provider && provider.serviceAreas && provider.serviceAreas.length > 0) { %>
                            <div class="location-tags">
                                <% for (var k = 0; k < provider.serviceAreas.length; k++) {
                                    var area = provider.serviceAreas[k];
                                %>
                                    <div class="location-tag d-inline-block bg-primary text-white rounded-pill px-3 py-1 me-2 mb-2"
                                        data-id="<%= area._id %>" data-lat="<%= area.lat %>" data-lng="<%= area.lng %>"
                                        data-radius="<%= area.radius %>" data-name="<%= area.name %>">
                                        <small><%= area.name %></small>
                                        <button class="btn-remove-location border-0 bg-transparent text-white p-0 ms-1"
                                            data-id="<%= area._id %>">
                                            <i class="fas fa-times-circle"></i>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info py-2 px-3 mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                <small>You haven't added any specific service areas yet.</small>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="add-location mt-3">
                    <h6 class="fs-6 mb-2">Add New Service Area</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <input type="text" id="new-location" class="form-control form-control-sm" placeholder="Search for a location" style="height: 32px; font-size: 14px;">
                        </div>
                        <div class="col-md-3">
                            <select id="radius-select" class="form-select form-select-sm" style="height: 32px; font-size: 14px;">
                                <option value="5">Within 5 km</option>
                                <option value="10" selected>Within 10 km</option>
                                <option value="15">Within 15 km</option>
                                <option value="20">Within 20 km</option>
                                <option value="25">Within 25 km</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid">
                                <button id="add-location-btn" class="btn btn-sm btn-primary" style="height: 32px; font-size: 14px;">Add</button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <button id="detect-location-btn" type="button" class="btn btn-sm btn-outline-secondary" style="height: 32px; font-size: 14px;">
                            <i class="fas fa-location-arrow"></i> Detect My Location
                        </button>
                    </div>
                    <div id="location-map" class="rounded border" style="height: 300px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Travel Fees -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <h5 class="mb-0 fs-5">Travel Fee Settings</h5>
        </div>
        <div class="card-body py-3">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="travel-fee-toggle">
                <label class="form-check-label small" for="travel-fee-toggle">
                    Enable travel fee for long distances
                </label>
            </div>

            <div id="travel-fee-options" class="mb-3" style="display: none;">
                <label class="form-label small">Travel Fee per km (beyond base radius)</label>
                <div class="input-group input-group-sm mb-2" style="max-width: 200px;">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="travel-fee-amount" placeholder="Amount per km" value="5">
                </div>
            </div>

            <button id="save-location-settings" class="btn btn-sm btn-primary">Save Fee Settings</button>
        </div>
    </div>
</div>

<style>
    .location-tag {
        transition: all 0.2s;
    }

    .location-tag:hover {
        background-color: #0056b3 !important;
    }

    .btn-xs {
        padding: 0.125rem 0.25rem;
        font-size: 0.75rem;
        line-height: 1.5;
    }

    .fs-7 {
        font-size: 0.75rem;
    }

    #location-map {
        box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.1);
    }

    .card {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .alert {
        border-radius: 0.375rem;
    }

    .btn-remove-location:hover {
        opacity: 0.8;
        transform: scale(1.1);
    }

    .map-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 300px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
    }

    .map-error {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 300px;
        background-color: #fff3cd;
        border: 1px solid #ffeaa7;
        border-radius: 0.375rem;
        color: #856404;
    }

    /* Custom styles for location search */
    .pac-container {
        z-index: 9999;
        font-size: 14px;
    }

    .pac-item {
        padding: 8px;
        font-size: 14px;
    }

    /* Fix for autocomplete dropdown styling */
    .pac-container .pac-item {
        border-top: 1px solid #e6e6e6;
        cursor: pointer;
    }

    .pac-container .pac-item:hover {
        background-color: #ebebeb;
    }

    .pac-container .pac-item-selected {
        background-color: #4285f4;
        color: white;
    }

    /* Ensure input field height consistency */
    #new-location,
    #radius-select,
    #add-location-btn,
    #detect-location-btn {
        height: 32px !important;
        line-height: 1.4;
    }
</style>

<script>
(function() {

    var API_KEY = '<%= googleMapsApiKey %>';
    var MAP_ID = '<%= googleMapsId %>';
    
    // Set global variables for providerLocations.js to use
    window.googleMapsApiKey = API_KEY;
    window.googleMapsId = MAP_ID;
    
    // Initialize provider data for providerLocations.js
    try {
        window.providerData = {
            travelFeeEnabled: <%= provider && provider.travelFeeEnabled ? 'true' : 'false' %>,
            travelFeeAmount: <%= provider && provider.travelFeeAmount ? provider.travelFeeAmount : 5 %>,
            serviceAreas: <%- JSON.stringify((provider && provider.serviceAreas) || []) %>
        };
    } catch (error) {
        console.error('❌ Provider data setup failed:', error);
        window.providerData = {
            travelFeeEnabled: false,
            travelFeeAmount: 5,
            serviceAreas: []
        };
    }
    
})();

document.addEventListener('DOMContentLoaded', function() {

    
    // ONLY handle non-map related functionality
    var travelFeeToggle = document.getElementById('travel-fee-toggle');
    var travelFeeOptions = document.getElementById('travel-fee-options');
    var travelFeeInput = document.getElementById('travel-fee-amount');

    // Initialize travel fee toggle
    if (travelFeeToggle) {
        // Set initial state from provider data
        if (window.providerData && window.providerData.travelFeeEnabled) {
            travelFeeToggle.checked = true;
            if (travelFeeOptions) {
                travelFeeOptions.style.display = 'block';
            }
        }

        // Handle toggle changes
        travelFeeToggle.addEventListener('change', function() {

            if (travelFeeOptions) {
                travelFeeOptions.style.display = this.checked ? 'block' : 'none';
            }
        });
    }

    // Set travel fee amount from provider data
    if (travelFeeInput && window.providerData && window.providerData.travelFeeAmount) {
        travelFeeInput.value = window.providerData.travelFeeAmount;
    }


});
</script>