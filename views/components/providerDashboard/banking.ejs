<section id="banking" class="dashboard-section">
    <!-- Add this right after the opening section tag -->
    <input type="hidden" id="providerId" value="<%= provider._id %>">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-3">
        <h2 class="fs-4 fw-bold text-dark mb-0"><i class="fas fa-university text-primary me-2"></i>Banking & Payments</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 bg-white">
        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 bg-primary bg-opacity-10 h-100 rounded-4 transition-hover">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm me-3" style="width: 48px; height: 48px;">
                                <i class="fas fa-wallet fs-5"></i>
                            </div>
                            <div>
                                <h6 class="text-secondary fw-semibold mb-1 text-uppercase letter-spacing-1">Pending Payouts</h6>
                                <h4 class="fw-bold text-dark mb-0 fs-3">₹<span id="pendingPayoutsAmount">0.00</span></h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 bg-success bg-opacity-10 h-100 rounded-4 transition-hover">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="d-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow-sm me-3" style="width: 48px; height: 48px;">
                                <i class="fas fa-university fs-5"></i>
                            </div>
                            <div>
                                <h6 class="text-secondary fw-semibold mb-1 text-uppercase letter-spacing-1">Bank Status</h6>
                                <h5 class="mb-0" id="bankDetailsStatus">
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                                        <i class="fas fa-exclamation-circle me-1"></i> No Bank Details
                                    </span>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bank Details Required Message -->
        <div id="noBankDetailsSection" class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-start gap-3">
            <div class="text-warning">
                <i class="fas fa-exclamation-circle fa-2x"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-2">Add Your Bank Account Details</h5>
                <p class="mb-0 text-dark">To receive payments for your services, please add your bank account information. We need this to
                    transfer your earnings.</p>
            </div>
        </div>

        <!-- Pending Payouts Section -->
        <div id="pendingPayoutsSection" class="d-none">
            <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-start gap-3">
                <div class="text-info">
                    <i class="fas fa-info-circle fa-2x"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-2">Payout Information</h5>
                    <p class="mb-3 text-dark">Your payouts are processed within 7 business days after completion of service. You can view
                        your payout history below.</p>
                    <button class="btn btn-primary rounded px-4 shadow-sm" id="viewPayoutHistory">
                        <i class="fas fa-history me-1"></i> View Payout History
                    </button>
                </div>
            </div>
        </div>

        <!-- Bank Details Form -->
        <div class="mt-5">
            <h4 class="fs-5 fw-bold text-dark mb-4 pb-2 border-bottom">Bank Account Details</h4>
            <form id="bankDetailsForm" class="bg-light p-4 rounded-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="accountHolderName" class="form-label fw-medium text-dark">Account Holder Name <span
                                class="text-danger">*</span></label>
                        <input type="text" class="form-control shadow-sm border-0" id="accountHolderName" name="accountHolderName"
                            required>
                    </div>
                    <div class="col-md-6">
                        <label for="bankName" class="form-label fw-medium text-dark">Bank Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control shadow-sm border-0" id="bankName" name="bankName" required>
                    </div>
                    <div class="col-md-6">
                        <label for="accountNumber" class="form-label fw-medium text-dark">Account Number <span
                                class="text-danger">*</span></label>
                        <input type="text" class="form-control shadow-sm border-0" id="accountNumber" name="accountNumber" required>
                        <div class="form-text small text-secondary mt-1"><i class="fas fa-lock me-1 text-success"></i>This will be securely stored and used for payments only</div>
                    </div>
                    <div class="col-md-6">
                        <label for="ifscCode" class="form-label fw-medium text-dark">IFSC Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control shadow-sm border-0" id="ifscCode" name="ifscCode" required>
                        <div class="form-text small text-secondary mt-1">e.g., HDFC0001234</div>
                    </div>
                    <div class="col-12 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary rounded px-4 shadow-sm" id="saveBankDetails">
                            <i class="fas fa-save me-2"></i>Save Bank Details
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Payout History Modal -->
    <div class="modal fade" id="payoutHistoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Payout History</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Booking ID</th>
                                </tr>
                            </thead>
                            <tbody id="payoutHistoryTable">
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</section>