<section id="profile" class="dashboard-section">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-3">
    <h2 class="fs-4 fw-bold text-dark mb-0"><i class="fas fa-user-circle text-primary me-2"></i>Profile Information</h2>
    <div class="d-flex gap-2">
      <a href="/auth/reset-password" class="btn btn-outline-primary btn-sm rounded shadow-sm px-3 d-flex align-items-center">
        <i class="fas fa-key me-2"></i>Change Password
      </a>
      <button class="btn btn-primary btn-sm rounded shadow-sm px-3 d-flex align-items-center" onclick="openEditModal()">
        <i class="fas fa-edit me-2"></i>Edit Profile
      </button>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 bg-white">
    <div class="row">
      <!-- Profile Image Section - Removed change photo functionality -->
      <div class="col-md-4 text-center border-md-end pe-md-4 mb-4 mb-md-0">
        <div class="position-relative d-inline-block mb-3">
          <img src="<%= user.profileImage || '/img/default-avatar.png' %>" alt="Profile" 
            class="rounded-circle object-fit-cover shadow border border-3 border-white"
            style="width: 150px; height: 150px;"
            id="profilePreview" />
        </div>

        <h3 class="fw-bold text-dark mb-1 fs-4">
          <%= user.name %>
        </h3>
        <p class="text-secondary mb-3">
          <%= user.username %>
        </p>
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-medium">Provider Account</span>
      </div>

      <!-- Profile Details Section -->
      <div class="col-md-8 ps-md-4">
        <div class="row g-4">
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded-3 h-100">
              <label class="text-secondary small fw-bold text-uppercase letter-spacing-1 mb-2 d-flex align-items-center"><i class="fas fa-phone text-primary me-2"></i>Phone Number</label>
              <p class="fw-medium text-dark mb-0 fs-6">
                <%= user.phone || 'Not provided' %>
              </p>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded-3 h-100">
              <label class="text-secondary small fw-bold text-uppercase letter-spacing-1 mb-2 d-flex align-items-center"><i class="fas fa-map-marker-alt text-primary me-2"></i>Address</label>
              <p class="fw-medium text-dark mb-0 fs-6">
                <%= user.address || 'Not provided' %>
              </p>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded-3 h-100">
              <label class="text-secondary small fw-bold text-uppercase letter-spacing-1 mb-2 d-flex align-items-center"><i class="fas fa-id-card text-primary me-2"></i>Experience</label>
              <p class="fw-medium text-dark mb-0 fs-6">
                <%= provider.experience || 'Not specified' %> years
              </p>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded-3 h-100">
              <label class="text-secondary small fw-bold text-uppercase letter-spacing-1 mb-2 d-flex align-items-center"><i class="fas fa-certificate text-primary me-2"></i>Specialization</label>
              <p class="fw-medium text-dark mb-0 fs-6">
                <%= provider.specialization || 'Not specified' %>
              </p>
            </div>
          </div>
          <div class="col-12">
            <div class="p-3 bg-light rounded-3">
              <label class="text-secondary small fw-bold text-uppercase letter-spacing-1 mb-2 d-flex align-items-center"><i class="fas fa-calendar text-primary me-2"></i>Member Since</label>
              <p class="fw-medium text-dark mb-0 fs-6">
                <%= new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric' , month: 'long' ,
                  day: 'numeric' }) %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Add this at the end of your profile.ejs file -->

  <!-- Edit Profile Modal - Kept change photo functionality here -->
  <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editProfileModalLabel">Edit Profile</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <!-- Note: enctype attribute is crucial for file uploads -->
          <form id="editProfileForm" enctype="multipart/form-data">
            <div class="row mb-4">
              <div class="col-md-4 text-center">
                <div class="profile-image-container mb-3">
                  <img src="<%= user.profileImage || '/img/default-avatar.png' %>" alt="Profile" class="profile-image"
                    id="modalProfilePreview" />
                  <div class="image-overlay" onclick="document.getElementById('modalProfileImage').click()">
                    <i class="fas fa-camera"></i>
                    <span>Change Photo</span>
                  </div>
                  <input type="file" id="modalProfileImage" name="profileImage" accept="image/*"
                    style="display: none" />
                </div>
                <small class="text-muted d-block mb-3">Click on the image to change your profile photo</small>
              </div>
              <div class="col-md-8">
                <div class="mb-3">
                  <label for="name" class="form-label">Full Name</label>
                  <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required />
                </div>
                <div class="mb-3">
                  <label for="phone" class="form-label">Phone Number</label>
                  <input type="tel" class="form-control" id="phone" name="phone" value="<%= user.phone || '' %>" />
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="address" class="form-label">Address</label>
              <textarea class="form-control" id="address" name="address" rows="2"><%= user.address || '' %></textarea>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <label for="experience" class="form-label">Years of Experience</label>
                <input type="number" class="form-control" id="experience" name="experience"
                  value="<%= provider.experience || '' %>" min="0" />
              </div>
              <div class="col-md-6">
                <label for="specialization" class="form-label">Specialization</label>
                <input type="text" class="form-control" id="specialization" name="specialization"
                  value="<%= provider.specialization || '' %>" />
              </div>
            </div>

            <div class="mb-3">
              <label for="bio" class="form-label">Bio/About Me</label>
              <textarea class="form-control" id="bio" name="bio" rows="3"><%= provider.bio || '' %></textarea>
            </div>

            <div class="mt-3 text-center">
              <p class="text-muted">Need to change your password?
                <a href="/auth/reset-password" class="text-primary">Click here</a> to reset your password.
              </p>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="saveProfileBtn">Save Changes</button>
        </div>
      </div>
    </div>
  </div>
</section>



<script>
  // Function to handle the "Change Password" button
  function redirectToChangePassword() {
    window.location.href = '/auth/reset-password';
  }
</script>