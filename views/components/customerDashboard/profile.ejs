<section id="profile" class="dashboard-section">
  <div class="section-header">
    <h2><i class="fas fa-user-circle me-2"></i>Profile Information</h2>
    <button class="btn btn-primary btn-sm" onclick="openEditModal()">
      <i class="fas fa-edit me-1"></i>Edit Profile
    </button>
  </div>

  <div class="content-card" data-aos="fade-up">
    <div class="row">
      <!-- Profile Image Section -->
      <div class="col-md-4 text-center">
        <div class="profile-image-container mb-4">
          <img src="<%= user.profileImage || '/img/default-avatar.png' %>" alt="Profile" class="profile-image"
            id="profilePreview" />
          <div class="image-overlay" onclick="document.getElementById('profileImage').click()">
            <i class="fas fa-camera"></i>
            <span>Change Photo</span>
          </div>
          <input type="file" id="profileImage" name="profileImage" accept="image/*" style="display: none" />
        </div>

        <h3 class="user-name mb-1">
          <%= user.name %>
        </h3>
        <p class="user-email mb-4">
          <%= user.username %>
        </p>
      </div>

      <!-- Profile Details Section -->
      <div class="col-md-8">
        <div class="profile-details">
          <div class="detail-item">
            <label><i class="fas fa-phone"></i>Phone</label>
            <p>
              <%= user.phone || 'Not provided' %>
            </p>
          </div>

          <div class="detail-item">
            <label><i class="fas fa-envelope"></i>Email</label>
            <p>
              <%= user.username %>
            </p>
          </div>
          
          <div class="detail-item">
            <label><i class="fas fa-calendar-check"></i>Joined</label>
            <p>
              <%= new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric' , month: 'long' ,
                day: 'numeric' }) %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Profile Modal -->
  <div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Profile</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="editProfileForm">
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" id="editName" value="<%= user.name %>" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="editPhone" value="<%= user.phone || '' %>" />
            </div>
            <div class="mb-3">
              <label class="form-label">Address</label>
              <textarea class="form-control" id="editAddress" rows="3">
<%= user.address || '' %></textarea>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="button" class="btn btn-primary" onclick="saveProfile()">
            Save Changes
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Image Crop Modal -->
  <div class="modal fade" id="imageCropModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Crop Profile Picture</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="img-container bg-light rounded overflow-hidden" style="max-height: 400px;">
            <img id="cropImage" src="" alt="Picture to crop" class="w-100" />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="button" class="btn btn-primary" id="cropButton">
            <i class="fas fa-crop me-1"></i>Crop & Save
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="content-card mt-4" data-aos="fade-up" data-aos-delay="100">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="mb-0 fs-4 fw-bold text-dark"><i class="fas fa-map-marked-alt text-primary me-2 bg-primary bg-opacity-10 p-2 rounded"></i>My Addresses</h3>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
        <i class="fas fa-plus me-2"></i>Add New Address
      </button>
    </div>
    
    <div>
      <% if (user.addresses && user.addresses.length> 0) { %>
        <div class="row g-4">
          <% user.addresses.forEach((address, index)=> { %>
            <div class="col-md-6">
              <div class="address-card h-100 <%= address.isDefault ? 'border-primary' : '' %>">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="mb-0 d-flex align-items-center gap-2">
                      <span class="badge <%= address.isDefault ? 'bg-primary' : 'bg-secondary' %> px-3 py-2 rounded-pill">
                        <i class="fas <%= address.label === 'Home' ? 'fa-home' : address.label === 'Work' ? 'fa-briefcase' : 'fa-map-pin' %> me-1"></i>
                        <%= address.label %>
                      </span>
                      <% if (address.isDefault) { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill">Default</span>
                        <% } %>
                    </h6>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-v text-muted"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li>
                          <button class="dropdown-item py-2" data-bs-toggle="modal"
                            data-bs-target="#editAddressModal<%= index %>">
                            <i class="fas fa-edit me-2 text-primary"></i>Edit Address
                          </button>
                        </li>
                        <% if (!address.isDefault) { %>
                          <li>
                            <form action="/user/set-default-address/<%= index %>" method="POST">
                              <button type="submit" class="dropdown-item py-2">
                                <i class="fas fa-check-circle me-2 text-success"></i>Set as Default
                              </button>
                            </form>
                          </li>
                          <% } %>
                            <li>
                              <hr class="dropdown-divider">
                            </li>
                            <li>
                              <form action="/user/delete-address/<%= index %>" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this address?')">
                                <button type="submit" class="dropdown-item py-2 text-danger">
                                  <i class="fas fa-trash-alt me-2"></i>Remove Address
                                </button>
                              </form>
                            </li>
                      </ul>
                    </div>
                  </div>
                  <div class="text-secondary ps-1">
                    <p class="mb-1 fw-medium text-dark"><i class="fas fa-map-marker-alt text-muted me-2 w-15px text-center"></i><%= address.street %></p>
                    <p class="mb-1"><i class="fas fa-city text-muted me-2 w-15px text-center"></i><%= address.city %>, <%= address.state %></p>
                    <p class="mb-0"><i class="fas fa-mail-bulk text-muted me-2 w-15px text-center"></i>PIN: <span class="fw-medium text-dark"><%= address.pincode %></span></p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Edit Address Modal for this address -->
            <div class="modal fade" id="editAddressModal<%= index %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <form action="/user/update-address/<%= index %>" method="POST">
                    <div class="modal-header">
                      <h5 class="modal-title">Edit Address</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <!-- Address form fields pre-filled with existing values -->
                      <div class="mb-3">
                        <label for="label<%= index %>" class="form-label">Address Label</label>
                        <select class="form-select" id="label<%= index %>" name="label" required>
                          <option value="Home" <%=address.label==='Home' ? 'selected' : '' %>>Home</option>
                          <option value="Work" <%=address.label==='Work' ? 'selected' : '' %>>Work</option>
                          <option value="Other" <%=address.label==='Other' ? 'selected' : '' %>>Other</option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label for="street<%= index %>" class="form-label">Street Address</label>
                        <input type="text" class="form-control" id="street<%= index %>" name="street"
                          value="<%= address.street %>" placeholder="Street address, landmark, etc.">
                      </div>
                      <div class="row mb-3">
                        <div class="col">
                          <label for="city<%= index %>" class="form-label">City</label>
                          <input type="text" class="form-control" id="city<%= index %>" name="city"
                            value="<%= address.city %>" required>
                        </div>
                        <div class="col">
                          <label for="state<%= index %>" class="form-label">State</label>
                          <input type="text" class="form-control" id="state<%= index %>" name="state"
                            value="<%= address.state %>" required>
                        </div>
                      </div>
                      <div class="mb-3">
                        <label for="pincode<%= index %>" class="form-label">PIN Code</label>
                        <input type="text" class="form-control" id="pincode<%= index %>" name="pincode"
                          value="<%= address.pincode %>" required pattern="[0-9]{6}"
                          title="Enter a valid 6-digit PIN code">
                      </div>
                      <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="makeDefault<%= index %>" name="makeDefault"
                          value="true" <%=address.isDefault ? 'checked' : '' %>>
                        <label class="form-check-label" for="makeDefault<%= index %>">Set as default address</label>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
          <div class="text-center py-5 bg-light rounded-3 border border-dashed">
            <div class="mb-3">
              <i class="fas fa-map-marked-alt text-primary opacity-50" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No addresses added yet</h4>
            <p class="text-secondary mb-4 max-w-md mx-auto">Add your home or work address for faster bookings and better service provider matching.</p>
            <button class="btn btn-primary px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal">
              <i class="fas fa-plus me-2"></i>Add Your First Address
            </button>
          </div>
          <% } %>
    </div>
  </div>

  <!-- Add Address Modal -->
  <div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/user/add-address" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Add New Address</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Address form fields -->
            <div class="mb-3">
              <label for="label" class="form-label">Address Label</label>
              <select class="form-select" id="label" name="label" required>
                <option value="Home" selected>Home</option>
                <option value="Work">Work</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="street" class="form-label">Street Address</label>
              <input type="text" class="form-control" id="street" name="street"
                placeholder="Street address, landmark, etc.">
            </div>
            <div class="row mb-3">
              <div class="col">
                <label for="city" class="form-label">City</label>
                <input type="text" class="form-control" id="city" name="city" required>
              </div>
              <div class="col">
                <label for="state" class="form-label">State</label>
                <input type="text" class="form-control" id="state" name="state" required>
              </div>
            </div>
            <div class="mb-3">
              <label for="pincode" class="form-label">PIN Code</label>
              <input type="text" class="form-control" id="pincode" name="pincode" required pattern="[0-9]{6}"
                title="Enter a valid 6-digit PIN code">
            </div>
            <div class="mb-3 form-check">
              <input type="checkbox" class="form-check-input" id="makeDefault" name="makeDefault" value="true">
              <label class="form-check-label" for="makeDefault">Set as default address</label>
            </div>
            <!-- Auto-detect location button -->
            <div class="d-grid mt-4">
              <button type="button" class="btn btn-outline-primary border-dashed" id="detectLocationBtn">
                <i class="fas fa-location-arrow me-2"></i>Auto-detect My Location
              </button>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary px-4">Save Address</button>
          </div>
        </form>
      </div>
    </div>
  </div>


</section>

<!-- Add this script for auto-detection of location -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const detectLocationBtn = document.getElementById('detectLocationBtn');

    if (detectLocationBtn) {
      detectLocationBtn.addEventListener('click', function () {
        if (navigator.geolocation) {
          // Show loading state
          detectLocationBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Detecting Location...';
          detectLocationBtn.disabled = true;

          navigator.geolocation.getCurrentPosition(
            function (position) {
              // Get reverse geocoding data
              reverseGeocode(position.coords.latitude, position.coords.longitude);
            },
            function (error) {
              console.error('Geolocation error:', error);
              detectLocationBtn.innerHTML = '<i class="fas fa-location-arrow me-2"></i>Auto-detect My Location';
              detectLocationBtn.disabled = false;
              alert('Unable to detect your location. Please check your browser permissions.');
            }
          );
        } else {
          alert('Geolocation is not supported by your browser.');
        }
      });
    }

    // Function to get address from coordinates
    function reverseGeocode(lat, lng) {
      // Use a geocoding service (this example uses MapQuest)
      fetch(`https://www.mapquestapi.com/geocoding/v1/reverse?key=YOUR_API_KEY&location=${lat},${lng}&includeRoadMetadata=true&includeNearestIntersection=true`)
        .then(response => response.json())
        .then(data => {
          if (data && data.results && data.results[0] && data.results[0].locations && data.results[0].locations[0]) {
            const location = data.results[0].locations[0];

            // Fill the form fields with the detected address
            document.getElementById('street').value = location.street || '';
            document.getElementById('city').value = location.adminArea5 || ''; // City
            document.getElementById('state').value = location.adminArea3 || ''; // State
            document.getElementById('pincode').value = location.postalCode || '';

            // Reset button state
            detectLocationBtn.innerHTML = '<i class="fas fa-check text-success me-2"></i>Location Detected Successfully';
            detectLocationBtn.classList.replace('btn-outline-primary', 'btn-outline-success');
            setTimeout(() => {
                detectLocationBtn.disabled = false;
            }, 2000);
          } else {
            throw new Error('Invalid geocoding response');
          }
        })
        .catch(error => {
          console.error('Reverse geocoding error:', error);
          detectLocationBtn.innerHTML = '<i class="fas fa-location-arrow me-2"></i>Auto-detect My Location';
          detectLocationBtn.disabled = false;
          alert('Unable to get your address. Please enter it manually.');
        });
    }
  });
</script>
<script src="/js/pages/profile/edit.js"></script>