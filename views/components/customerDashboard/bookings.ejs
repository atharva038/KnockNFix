<section id="bookings" class="dashboard-section active">
  <div class="section-header">
    <h2><i class="fas fa-calendar-alt me-2"></i>Your Bookings</h2>
    <div class="section-actions">
      <select class="form-select status-filter">
        <option value="all">All Bookings</option>
        <option value="pending">Pending</option>
        <option value="confirmed">Confirmed</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>
  </div>

  <div class="booking-stats-row" data-aos="fade-up">
    <div class="stat-card">
      <div class="stat-icon total"><i class="fas fa-list-ul"></i></div>
      <div class="stat-details">
        <h4>Total Bookings</h4>
        <p class="stat-number"><%= bookings.length %></p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon pending"><i class="fas fa-clock"></i></div>
      <div class="stat-details">
        <h4>Pending</h4>
        <p class="stat-number"><%= bookings.filter(b => b.status === 'pending').length %></p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon completed"><i class="fas fa-check-circle"></i></div>
      <div class="stat-details">
        <h4>Completed</h4>
        <p class="stat-number"><%= bookings.filter(b => b.status === 'completed').length %></p>
      </div>
    </div>
  </div>

  <div class="content-card" data-aos="fade-up" data-aos-delay="100">
    <div class="table-responsive">
      <table class="table booking-table">
        <thead>
          <tr>
            <th>Service</th>
            <th>Provider</th>
            <th>Date & Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(bookings.length === 0) { %>
            <tr>
              <td colspan="5">
                <div class="no-bookings-message">
                  <i class="fas fa-calendar-times"></i>
                  <h4>No Bookings Yet</h4>
                  <p>You haven't made any bookings. Explore our services to get started!</p>
                  <a href="/services" class="btn btn-primary mt-3">Browse Services</a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% bookings.forEach(booking=> { %>
              <tr data-aos="fade-up" data-aos-delay="150">
                <td data-label="Service">
                  <div class="service-info">
                    <div class="service-icon"><i class="fas fa-tools"></i></div>
                    <div>
                      <div class="service-name">
                        <%= booking.service.name %>
                      </div>
                      <div class="service-price">₹<%= booking.totalCost %>
                      </div>
                    </div>
                  </div>
                </td>
                <td data-label="Provider">
                  <div class="provider-info">
                    <% if (booking.provider && booking.provider.user) { %>
                      <img src="<%= booking.provider.user.profileImage || '/img/default-avatar.png' %>" alt="Provider"
                        class="provider-img" />
                      <div class="provider-name">
                        <%= booking.provider.user.name %>
                      </div>
                      <% } else { %>
                        <img src="/img/default-avatar.png" alt="Provider" class="provider-img" />
                        <div class="provider-name">
                          <span class="text-muted">Not assigned</span>
                        </div>
                        <% } %>
                  </div>
                </td>
                <td data-label="Date & Time">
                  <div class="booking-time">
                    <div class="booking-date">
                      <% try { const bookingDate=new Date(booking.bookingDate); if (!isNaN(bookingDate.getTime())) { %>
                        <%= bookingDate.toLocaleDateString('en-IN', { weekday: 'short' , year: 'numeric' , month: 'short' ,
                          day: 'numeric' }) %>
                          <% } else { %>N/A<% } } catch (error) { %>Error<% } %>
                    </div>
                    <div class="booking-hour">
                      <% try { const bookingDate=new Date(booking.bookingDate); if (!isNaN(bookingDate.getTime())) { %>
                        <%= bookingDate.toLocaleTimeString('en-IN', { hour: '2-digit' , minute: '2-digit' , hour12: true
                          }) %>
                          <% } else { %>N/A<% } } catch (error) { %>Error<% } %>
                    </div>
                  </div>
                </td>
                <td data-label="Status">
                  <span class="status-badge status-<%= booking.status.toLowerCase() %>">
                    <%= booking.status %>
                  </span>
                </td>
                <td data-label="Actions">
                  <div class="booking-actions">
                    <button class="btn view-booking-btn" title="View Details"
                      data-id="<%= booking._id %>" data-bs-toggle="modal" data-bs-target="#viewBookingModal">
                      <i class="fas fa-eye"></i>
                    </button>
                    <% if (booking.status==='pending' ) { %>
                      <button class="btn cancel-booking-btn" title="Cancel Booking"
                        data-id="<%= booking._id %>">
                        <i class="fas fa-times"></i>
                      </button>
                      <% } %>
                  </div>
                </td>
              </tr>
              <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="modal fade" id="viewBookingModal" tabindex="-1" aria-labelledby="viewBookingModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="viewBookingModalLabel">
            <i class="fas fa-calendar-check me-2 text-primary"></i>Booking Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="booking-details-container">
            <div class="row booking-header">
              <div class="col-md-8">
                <h3 id="modal-service-name">Loading...</h3>
                <p class="provider-name text-muted mt-2">
                  <i class="fas fa-user-tie me-2"></i>
                  <span id="modal-provider-name">Loading...</span>
                </p>
              </div>
              <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span id="modal-booking-status" class="status-badge">Loading...</span>
              </div>
            </div>

            <div class="row mt-4">
              <div class="col-md-6">
                <div class="detail-group">
                  <label><i class="fas fa-calendar-day me-2"></i>Booking Date</label>
                  <p id="modal-booking-date">Loading...</p>
                </div>

                <div class="detail-group">
                  <label><i class="fas fa-map-marker-alt me-2"></i>Service Address</label>
                  <p id="modal-booking-address">Loading...</p>
                </div>

                <div class="detail-group">
                  <label><i class="fas fa-clipboard-list me-2"></i>Notes</label>
                  <p id="modal-booking-notes">Loading...</p>
                </div>
              </div>

              <div class="col-md-6">
                <div class="detail-group">
                  <label><i class="fas fa-receipt me-2"></i>Total Cost</label>
                  <h4 id="modal-booking-cost" class="text-primary">Loading...</h4>
                </div>

                <div class="detail-group">
                  <label><i class="fas fa-money-check-alt me-2"></i>Payment Status</label>
                  <p id="modal-payment-status">Loading...</p>
                </div>

                <div id="payment-info-container" class="mt-4 pt-3 border-top">
                  <!-- Payment information will be injected here -->
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top-0 bg-light rounded-bottom">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Close
          </button>
          <div id="modal-action-buttons">
            <!-- Action buttons will be injected here based on booking status -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>