<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="KnockNFix Admin Dashboard">
    <meta name="author" content="KnockNFix">
    <title>
        <%= locals.title || "Admin Panel" %> - KnockNFix
    </title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Admin Panel CSS -->
    <link rel="stylesheet" href="/css/adminPanel.css">

    <!-- Additional page-specific styles -->
    <% if (locals.pageStyle) { %>
        <!-- <style>
            <%=locals.pageStyle %>
        </style> -->
    <% } %>
</head>

<body>
    <div class="admin-container d-flex">
        <!-- Sidebar -->
        <div class="admin-sidebar d-flex flex-column" id="sidebar">
            <div class="sidebar-header d-flex align-items-center justify-content-between px-4 text-white">
                <h3 class="m-0 fw-bold fs-5 text-uppercase" style="letter-spacing: 1px; text-shadow: 0 1px 2px rgba(0,0,0,0.1); z-index: 1;">KnockNFix</h3>
                <button class="btn text-white sidebar-toggle p-0" id="sidebarToggle" aria-label="Toggle Sidebar" style="z-index: 1;">
                    <i class="fas fa-angles-left"></i>
                </button>
            </div>

            <div class="sidebar-menu py-3 overflow-auto flex-grow-1">
                <ul class="nav flex-column">
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/dashboard' ? 'active' : '' %>">
                        <a href="/admin/dashboard" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-tachometer-alt"></i>
                            </div>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/users' ? 'active' : '' %>">
                        <a href="/admin/users" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-users"></i>
                            </div>
                            <span>Users</span>
                        </a>
                    </li>
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/categories' ? 'active' : '' %>">
                        <a href="/admin/categories" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-th-large"></i>
                            </div>
                            <span>Categories</span>
                        </a>
                    </li>
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/services' ? 'active' : '' %>">
                        <a href="/admin/services" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-tools"></i>
                            </div>
                            <span>Services</span>
                        </a>
                    </li>
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/bookings' ? 'active' : '' %>">
                        <a href="/admin/bookings" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <span>Bookings</span>
                        </a>
                    </li>
                    <li class="nav-item mx-3 my-1 rounded overflow-hidden <%= locals.currentPath === '/admin/provider-payouts' ? 'active' : '' %>">
                        <a href="/admin/provider-payouts" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded">
                            <div class="nav-icon bg-white text-secondary shadow-sm rounded-3 d-flex align-items-center justify-content-center me-3">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <span>Provider Payouts</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="p-3 border-top border-secondary border-opacity-25 mt-auto">
                <a href="/logout" class="nav-link px-3 py-2 d-flex align-items-center fw-semibold rounded text-danger icon-btn-hover">
                    <i class="fas fa-sign-out-alt me-3 fs-5"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="admin-content d-flex flex-column">
            <!-- Header -->
            <div class="bg-white border-bottom shadow-sm d-flex align-items-center justify-content-between px-4" style="height: var(--header-height);">
                <div class="d-flex align-items-center">
                    <button class="btn sidebar-toggle d-md-none icon-btn-hover border-0" id="mobileSidebarToggle" aria-label="Mobile Menu">
                        <i class="fas fa-bars text-secondary fs-5"></i>
                    </button>
                    <div class="breadcrumbs ms-3 d-none d-sm-block">
                        <% if (locals.breadcrumbs && Array.isArray(locals.breadcrumbs)) { %>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/admin/dashboard" class="text-decoration-none text-secondary fw-medium">
                                            <i class="fas fa-home small me-1"></i>Dashboard
                                        </a>
                                    </li>
                                    <% locals.breadcrumbs.forEach(function(breadcrumb) { %>
                                        <li class="breadcrumb-item fw-medium <%= breadcrumb.active ? 'active text-dark' : '' %>">
                                            <% if (breadcrumb.url && !breadcrumb.active) { %>
                                                <a href="<%= breadcrumb.url %>" class="text-decoration-none text-secondary">
                                                    <%= breadcrumb.text %>
                                                </a>
                                            <% } else { %>
                                                <%= breadcrumb.text %>
                                            <% } %>
                                        </li>
                                    <% }); %>
                                </ol>
                            </nav>
                        <% } %>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Notifications -->
                    <div class="dropdown">
                        <button class="btn border-0 rounded-circle icon-btn-hover position-relative p-2" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" aria-label="Notifications">
                            <i class="fas fa-bell text-secondary fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.65rem;">3</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-0" style="min-width: 280px;">
                            <div class="bg-primary text-white p-3 rounded-top-3">
                                <h6 class="m-0 fw-semibold">Notifications</h6>
                            </div>
                            <div class="notification-list" style="max-height: 300px; overflow-y: auto;">
                                <a href="#" class="dropdown-item py-3 border-bottom text-wrap">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <p class="mb-1 fw-medium text-dark">New user registered</p>
                                            <small class="text-muted">5 minutes ago</small>
                                        </div>
                                    </div>
                                </a>
                                <a href="#" class="dropdown-item py-3 border-bottom text-wrap">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                        <div>
                                            <p class="mb-1 fw-medium text-dark">Payment received</p>
                                            <small class="text-muted">2 hours ago</small>
                                        </div>
                                    </div>
                                </a>
                                <a href="#" class="dropdown-item py-3 border-bottom text-wrap">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </div>
                                        <div>
                                            <p class="mb-1 fw-medium text-dark">System alert</p>
                                            <small class="text-muted">Yesterday</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <a href="/admin/notifications" class="dropdown-item text-center py-2 fw-medium text-primary bg-light rounded-bottom-3">
                                View All Notifications
                            </a>
                        </div>
                    </div>

                    <!-- User Profile -->
                    <div class="dropdown">
                        <button class="btn border-0 rounded-pill icon-btn-hover p-1 pe-3 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=4e73df&color=fff" alt="Admin"
                                class="rounded-circle border border-2 border-primary border-opacity-25" style="width: 32px; height: 32px; object-fit: cover;" loading="lazy">
                            <span class="d-none d-md-inline fw-medium text-secondary">Admin</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2"
                            style="min-width: 220px;">
                            <div class="px-4 py-3 text-center mb-1">
                                <img src="https://ui-avatars.com/api/?name=Admin&background=4e73df&color=fff"
                                    alt="Admin" class="rounded-circle mb-2 border border-2 border-primary border-opacity-25" width="60" height="60" loading="lazy">
                                <h6 class="mb-0 fw-bold">Admin User</h6>
                                <small class="text-muted">Administrator</small>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/admin/profile" class="dropdown-item py-2 fw-medium text-secondary">
                                <i class="fas fa-user me-2 text-primary text-opacity-75" style="width: 20px;"></i>Profile
                            </a>
                            <a href="/admin/settings" class="dropdown-item py-2 fw-medium text-secondary">
                                <i class="fas fa-cog me-2 text-primary text-opacity-75" style="width: 20px;"></i>Settings
                            </a>
                            <a href="/admin/activity" class="dropdown-item py-2 fw-medium text-secondary">
                                <i class="fas fa-history me-2 text-primary text-opacity-75" style="width: 20px;"></i>Activity Log
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="/logout" class="dropdown-item py-2 fw-medium text-danger">
                                <i class="fas fa-sign-out-alt me-2" style="width: 20px;"></i>Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="admin-page-content p-4 flex-grow-1">
                <!-- Flash messages -->
                <% if (locals.success && locals.success.length> 0) { %>
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 bg-success bg-opacity-10 text-success fw-medium" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        <%= locals.success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <% if (locals.error && locals.error.length> 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 bg-danger bg-opacity-10 text-danger fw-medium" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <%= locals.error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- Main content from each page -->
                <%- body %>
            </div>

            <!-- Footer -->
            <footer class="bg-white p-4 border-top text-secondary small fw-medium mt-auto">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="text-center text-md-start mb-2 mb-md-0">
                        &copy; <%= new Date().getFullYear() %> KnockNFix. All rights reserved.
                    </div>
                    <div class="text-center text-md-end">
                        <span>Version 1.0.0</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Admin Panel JS -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar toggle functionality
            const sidebarToggle = document.getElementById('sidebarToggle');
            const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
            const adminContainer = document.querySelector('.admin-container');

            // Check for saved state
            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                adminContainer.classList.add('sidebar-collapsed');
                updateToggleIcon();
            }

            function toggleSidebar() {
                adminContainer.classList.toggle('sidebar-collapsed');
                // Save state in localStorage
                localStorage.setItem('sidebarCollapsed', adminContainer.classList.contains('sidebar-collapsed'));
                updateToggleIcon();
            }

            function updateToggleIcon() {
                const isCollapsed = adminContainer.classList.contains('sidebar-collapsed');
                const icon = sidebarToggle.querySelector('i');

                if (isCollapsed) {
                    icon.classList.remove('fa-angles-left');
                    icon.classList.add('fa-angles-right');
                } else {
                    icon.classList.remove('fa-angles-right');
                    icon.classList.add('fa-angles-left');
                }
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', toggleSidebar);
            }

            if (mobileSidebarToggle) {
                mobileSidebarToggle.addEventListener('click', toggleSidebar);
            }

            // Mobile sidebar backdrop click handler
            document.addEventListener('click', function (event) {
                const sidebar = document.getElementById('sidebar');

                if (window.innerWidth < 768 &&
                    adminContainer.classList.contains('sidebar-collapsed') &&
                    !sidebar.contains(event.target) &&
                    !mobileSidebarToggle.contains(event.target)) {
                    adminContainer.classList.remove('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', 'false');
                    updateToggleIcon();
                }
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function (e) {
                const dropdowns = document.querySelectorAll('.dropdown-menu.show');
                const dropdownToggles = document.querySelectorAll('.dropdown-toggle');

                dropdowns.forEach(dropdown => {
                    if (!dropdown.contains(e.target) &&
                        !Array.from(dropdownToggles).some(toggle => toggle.contains(e.target))) {
                        dropdown.classList.remove('show');
                    }
                });
            });

            // Auto hide alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>

    <!-- Additional scripts -->
    <% if (locals.extraScripts && Array.isArray(locals.extraScripts)) { %>
        <% locals.extraScripts.forEach(function(script) { %>
            <script src="<%= script %>"></script>
        <% }); %>
    <% } %>

    <!-- Page specific script -->
    <% if (locals.pageScript) { %>
        <!-- <script><% - locals.pageScript %></script> -->
    <% } %>
</body>

</html>