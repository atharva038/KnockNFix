<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" sizes="32x32" href="/img/logo.jpg" type="img" />
    <title>KnockNFix</title>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css"
    />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

    <!-- Essential Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <!-- AOS Animation Library CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Load Google Maps initialization script -->
    <script src="/js/pages/maps/mapInit.js"></script>
  </head>

  <body>
    <%- include("../includes/navbar.ejs") %> <%-
    include('../includes/languageSwitcher.ejs') %><%-
    include("../includes/flash.ejs") %> <%- body %> <%-
    include("../includes/footer.ejs") %>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>

    <!-- AOS Animation Library JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        AOS.init({
          duration: 800,
          once: true,
          offset: 100
        });
      });
    </script>

    <!-- Initialize Google Maps API with your configuration -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Only load Google Maps API if we have the loader available
        if (typeof window.loadGoogleMapsAPI === "function") {
          // Load the API with your key and optional Map ID
          window
            .loadGoogleMapsAPI(
              "<%= process.env.GOOGLE_MAPS_API_KEY %>",
              '<%= process.env.GOOGLE_MAP_ID || "" %>'
            )
            .then(() => {
              // API loaded successfully
            })
            .catch((error) => {
              // Handle API loading error silently
            });
        }
      });
    </script>

    <!-- Load map-specific scripts after initialization -->
    <script src="/js/pages/maps/mapBooking.js"></script>

    <!-- Make sure this div is present in the DOM -->
    <div id="google_translate_element" style="display: none"></div>

    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement(
          {
            pageLanguage: "en",
            includedLanguages:
              "en,hi,bn,gu,mr,ta,te,pa,ml,kn,ur,or,as,ne,sa,sd,ks,doi,mn,st,ma,bh",
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
            autoDisplay: false,
            gaTrack: false,
            gaId: "",
          },
          "google_translate_element"
        );

        // Hide the Google translate toolbar
        var bannerFrame = document.querySelector(".goog-te-banner-frame");
        if (bannerFrame) {
          bannerFrame.style.display = "none";
        }
      }
    </script>
    <script
      type="text/javascript"
      src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
    ></script>

    <!-- Load language switcher script after Google Translate -->
    <script src="/js/pages/common/languageSwitcher.js"></script>
  </body>
</html>
